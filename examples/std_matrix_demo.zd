// std_matrix_demo.zd - demo of std/matrix mul + det2.
// Run from the repo root:
//   go run . examples/std_matrix_demo.zd
//   go run . --eng=eval examples/std_matrix_demo.zd
import "std/matrix" as m
import "std/fmt" as fmt

let a = m.new(2, 2, [1, 2, 3, 4])
let b = m.new(2, 2, [5, 6, 7, 8])
fmt.println(m.mul(a, b))
fmt.println(m.det2(a))
