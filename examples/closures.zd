// Functions and closures
let add = fn(x, y) { x + y }
println(add(2, 3))  // 5

let makeAdder = fn(x) {
    fn(y) { x + y }
}
let addFive = makeAdder(5)
println(addFive(10))    // 15

let doubleAll = fn(xs) {
    let result = []
    for (i := 0; i < len(xs); i++) {
        result = push(result, xs[i] * 2)
    }
    result
}
println(doubleAll([1, 2, 3]))  // [2, 4, 6]
