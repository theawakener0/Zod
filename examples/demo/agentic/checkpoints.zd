// checkpoints.zd — per-turn file checkpoints for /undo.
//
// Before a mutating tool (write_file, edit, apply_patch) runs, the pre-edit
// content of each file it will touch is copied under
// <base>/<session>/<turn>/. Each checkpoint directory holds:
//   manifest.jsonl   one JSON line per touched file
//   files/NNNN.txt   the previous content of that file (when captured)
// First capture wins per file: a path listed twice in one capture is
// recorded only once, so its pre-edit content is never overwritten.
//
// /undo restores the most recent checkpoint: stored files are written back,
// and files that did not exist before the turn are deleted. Shell side
// effects are deliberately NOT captured — only the mutating tools' targets.
//
// All fs/json access is guarded with try(); nothing here prints and no path
// in this module raises.

import "std/fs" as fs
import "std/str" as str
import "std/array" as arr
import "std/json" as json
import "std/time" as time

pad3 := fn(n) {
    return str.pad_left(string(n), 3, "0")
}

pad4 := fn(n) {
    return str.pad_left(string(n), 4, "0")
}

// dir_rank orders checkpoint directories deterministically: the numeric turn
// prefix times 1e13 plus the optional millisecond suffix. Used to break ties
// between captures that share the same millisecond timestamp (later turn or
// later suffixed run wins).
dir_rank := fn(nm) {
    parts := str.split(nm, "-")
    base := 0
    if (len(parts) > 0) {
        hr := try(int(parts[0]))
        if (hr[0]) {
            base = hr[1]
        }
    }
    tail := 0
    if (len(parts) > 1) {
        tr2 := try(int(parts[1]))
        if (tr2[0]) {
            tail = tr2[1]
        }
    }
    return base * 10000000000000 + tail
}

// File paths named by a Codex-style patch: "*** Add File: x", "*** Update
// File: x", "*** Delete File: x" and "*** Move to: x" lines. Tolerant:
// non-string input returns [] and malformed text is simply skipped.
pub patch_paths := fn(text) {
    out := []
    if (type(text) != "STRING") {
        return out
    }
    markers := ["*** Add File: ", "*** Update File: ", "*** Delete File: ", "*** Move to: "]
    lines := str.split(text, "\n")
    for (i := 0; i < len(lines); i += 1) {
        line := str.trim(lines[i])
        for (j := 0; j < len(markers); j += 1) {
            m := markers[j]
            if (str.starts_with(line, m)) {
                rest := str.trim(str.slice(line, len(m), len(line)))
                if (rest != "") {
                    out = arr.push(out, rest)
                }
                break
            }
        }
    }
    return out
}

// Copy the pre-edit content of each path in `paths` into this turn's
// checkpoint directory. Returns the number of manifest entries appended
// (0 when there is nothing useful to record).
pub capture := fn(session_id, turn, cwd, paths, base) {
    sess := "nosession"
    if (type(session_id) == "STRING" && session_id != "") {
        sess = session_id
    }
    tn := 1
    if (type(turn) == "INTEGER" && turn > 0) {
        tn = turn
    }
    if (type(base) != "STRING" || base == "") {
        return 0
    }
    dir := base + "/" + sess + "/" + pad3(tn)
    // A resumed session may restart turn numbers; keep both histories apart.
    ex := try(fs.exists(dir))
    if (ex[0] && ex[1] == true) {
        dir = dir + "-" + string(time.now_ms())
    }
    seen := []
    count := 0
    ignored := null
    if (type(paths) != "ARRAY") {
        return 0
    }
    for (i := 0; i < len(paths); i += 1) {
        p := paths[i]
        if (type(p) != "STRING" || p == "") {
            continue
        }
        abs := ""
        if (str.starts_with(p, "/")) {
            abs = p
        } else {
            if (type(cwd) != "STRING" || cwd == "") {
                continue
            }
            abs = cwd + "/" + p
        }
        if (arr.contains(seen, abs)) {
            continue
        }
        seen = arr.push(seen, abs)
        existed := false
        content := ""
        r := try(fs.read_file(abs))
        if (r[0] && type(r[1]) == "STRING") {
            existed = true
            content = r[1]
        }
        stored := existed
        if (existed && len(content) > 1000000) {
            stored = false
        }
        name := pad4(count) + ".txt"
        if (stored) {
            ignored = try(fs.mkdir(dir + "/files"))
            w := try(fs.write_file(dir + "/files/" + name, content))
            if (!w[0]) {
                stored = false
            }
        }
        entry := {"name": name, "path": abs, "existed": existed, "stored": stored, "ts": time.now_ms()}
        jl := try(json.stringify(entry))
        if (jl[0]) {
            ignored = try(fs.mkdir(dir))
            a := try(fs.append_file(dir + "/manifest.jsonl", jl[1] + "\n"))
            if (a[0]) {
                count += 1
            }
        }
    }
    return count
}

// Restore the most recent checkpoint of a session: stored files are written
// back, files created during the turn are deleted. The newest checkpoint is
// the one whose last manifest entry has the greatest millisecond timestamp;
// equal timestamps fall back to the numeric directory rank (later turn wins)
// and then directory mtime, so captures in the same second or millisecond
// still order deterministically. Always returns a human-readable report
// string; never raises.
pub undo_last := fn(session_id, base) {
    sess := "nosession"
    if (type(session_id) == "STRING" && session_id != "") {
        sess = session_id
    }
    if (type(base) != "STRING" || base == "") {
        return "nothing to undo"
    }
    sdir := base + "/" + sess
    lr := try(fs.ls(sdir))
    if (!lr[0] || type(lr[1]) != "ARRAY") {
        return "nothing to undo"
    }
    names := lr[1]
    best := ""
    best_key := -1
    best_rank := -1
    best_mt := -1
    for (i := 0; i < len(names); i += 1) {
        nm := names[i]
        if (type(nm) != "STRING" || nm == "") {
            continue
        }
        mt := -1
        sr := try(fs.stat(sdir + "/" + nm))
        if (sr[0] && type(sr[1]) == "HASH" && type(sr[1]["mtime"]) == "INTEGER") {
            mt = sr[1]["mtime"]
        }
        key := mt
        mfr := try(fs.read_file(sdir + "/" + nm + "/manifest.jsonl"))
        if (mfr[0] && type(mfr[1]) == "STRING") {
            mlines := str.split(mfr[1], "\n")
            for (kk := len(mlines) - 1; kk >= 0; kk -= 1) {
                mln := str.trim(mlines[kk])
                if (mln == "") {
                    continue
                }
                mpr := try(json.parse(mln))
                if (mpr[0] && type(mpr[1]) == "HASH" && type(mpr[1]["ts"]) == "INTEGER") {
                    key = mpr[1]["ts"]
                }
                break
            }
        }
        if (key < 0 && mt < 0) {
            continue
        }
        rank := dir_rank(nm)
        better := false
        if (best == "") {
            better = true
        } else if (key > best_key) {
            better = true
        } else if (key == best_key && rank > best_rank) {
            better = true
        } else if (key == best_key && rank == best_rank && mt > best_mt) {
            better = true
        }
        if (better == true) {
            best = sdir + "/" + nm
            best_key = key
            best_rank = rank
            best_mt = mt
        }
    }
    if (best == "") {
        return "nothing to undo"
    }
    restored := 0
    deleted := 0
    skipped := 0
    rep := try(fs.read_file(best + "/manifest.jsonl"))
    if (rep[0] && type(rep[1]) == "STRING") {
        lines := str.split(rep[1], "\n")
        for (i := 0; i < len(lines); i += 1) {
            line := str.trim(lines[i])
            if (line == "") {
                continue
            }
            pr := try(json.parse(line))
            if (!pr[0] || type(pr[1]) != "HASH") {
                continue
            }
            e := pr[1]
            p := e["path"]
            if (type(p) != "STRING" || p == "") {
                continue
            }
            existed := (e["existed"] == true)
            stored := (e["stored"] == true)
            if (existed && stored) {
                fr := try(fs.read_file(best + "/files/" + string(e["name"])))
                ok := false
                if (fr[0] && type(fr[1]) == "STRING") {
                    w := try(fs.write_file(p, fr[1]))
                    if (w[0]) {
                        ok = true
                    }
                }
                if (ok) {
                    restored += 1
                } else {
                    skipped += 1
                }
            } else if (existed) {
                skipped += 1
            } else {
                ex := try(fs.exists(p))
                if (ex[0] && ex[1] == true) {
                    rm := try(fs.rm(p))
                    if (rm[0]) {
                        deleted += 1
                    } else {
                        skipped += 1
                    }
                }
            }
        }
    }
    ignored := try(fs.rm(best))
    parts := str.split(best, "/")
    last := best
    if (len(parts) > 0) {
        last = parts[len(parts) - 1]
    }
    report := "undid " + last + ": restored " + string(restored) + ", deleted " + string(deleted)
    if (skipped > 0) {
        report = report + ", skipped " + string(skipped)
    }
    return report
}

// Checkpoint turns of a session as "<dir-name>: <N> files" strings, where N
// counts the manifest entries (0 when the manifest is missing/unreadable).
// Returns [] when the session has no checkpoints.
pub list_turns := fn(session_id, base) {
    out := []
    sess := "nosession"
    if (type(session_id) == "STRING" && session_id != "") {
        sess = session_id
    }
    if (type(base) != "STRING" || base == "") {
        return out
    }
    sdir := base + "/" + sess
    lr := try(fs.ls(sdir))
    if (!lr[0] || type(lr[1]) != "ARRAY") {
        return out
    }
    names := lr[1]
    for (i := 0; i < len(names); i += 1) {
        nm := names[i]
        if (type(nm) != "STRING" || nm == "") {
            continue
        }
        n := 0
        fr := try(fs.read_file(sdir + "/" + nm + "/manifest.jsonl"))
        if (fr[0] && type(fr[1]) == "STRING") {
            lines := str.split(fr[1], "\n")
            for (j := 0; j < len(lines); j += 1) {
                if (str.trim(lines[j]) != "") {
                    n += 1
                }
            }
        }
        out = arr.push(out, nm + ": " + string(n) + " files")
    }
    return out
}
