// commands.zd — slash-command system for Zodex.
//
// Pure Zod: tools + pi + approvals + session + std (no network imports; all
// network goes through the cli hash in ctx).
//
// ctx shape (built by harness; commands must tolerate missing keys):
//   {"ui":ui,"ag":ag,"cli":cli,"tools":tool_list,"by_name":index,
//    "models_cache":[],"policy":policy,"guard":guard,"session":sess,
//    "tree":tree,"on_new":fn,"on_resume":fn}
// Each command run := fn(ctx, args) -> output STRING.
// Runs return "Error: ..." strings on failure, never error().
// Command names are stored WITHOUT the "/" prefix ("help", "model", ...);
// the "!" command handles "!<cmd>" shell lines.

import "tools.zd" as tools
import "pi.zd" as pi
import "approvals.zd" as approvals
import "session.zd" as session
import "checkpoints.zd" as checkpoints
import "pricing.zd" as pricing
import "std/str" as str
import "std/array" as arr
import "std/hash" as hash
import "std/json" as json

pub make_command := fn(name, hint, run) {
    return {"name": name, "hint": hint, "run": run}
}

pub make_registry := fn(commands) {
    return {"commands": commands}
}

// dispatch(reg, ctx, line) -> [handled_bool, output_string].
// Exact "/name" or "/name args..." prefix match (args = trimmed
// remainder, "" if none). "!<cmd>" routes to the builtin bang command.
// Unknown "/" line -> [true, "unknown command ... (try /help)"].
// Non-command line -> [false, ""].
pub dispatch := fn(reg, ctx, line) {
    cmds := reg["commands"]
    total := len(cmds)
    if (str.starts_with(line, "!")) {
        rest := str.trim(str.slice(line, 1, len(line)))
        for (i := 0; i < total; i += 1) {
            c := cmds[i]
            if (c["name"] == "!") {
                r := try(c["run"](ctx, rest))
                if (!r[0]) { return [true, "Error: " + string(r[1])] }
                return [true, string(r[1])]
            }
        }
        return [true, "unknown command ! (try /help)"]
    }
    if (!str.starts_with(line, "/")) {
        return [false, ""]
    }
    for (j := 0; j < total; j += 1) {
        d := cmds[j]
        nm := d["name"]
        if (nm == "!") { continue }
        pre := "/" + nm
        hit := false
        tail := ""
        if (line == pre) {
            hit = true
        } else if (str.starts_with(line, pre + " ")) {
            hit = true
            tail = str.trim(str.slice(line, len(pre), len(line)))
        }
        if (hit) {
            s := try(d["run"](ctx, tail))
            if (!s[0]) { return [true, "Error: " + string(s[1])] }
            return [true, string(s[1])]
        }
    }
    return [true, "unknown command " + line + " (try /help)"]
}

// Extract assistant text from a chat-completion envelope response.
// Returns "" when the shape is unexpected.
chat_text := fn(env) {
    if (type(env) != "HASH") { return "" }
    if (env["ok"] != true) { return "" }
    resp := env["resp"]
    if (type(resp) != "HASH") { return "" }
    ch := resp["choices"]
    if (type(ch) != "ARRAY" || len(ch) == 0) { return "" }
    first := ch[0]
    if (type(first) != "HASH") { return "" }
    mm := first["message"]
    if (type(mm) != "HASH") { return "" }
    if (mm["content"] == null) { return "" }
    return string(mm["content"])
}

chat_error := fn(env) {
    if (type(env) != "HASH") { return "unexpected client response" }
    if (env["error"] == null) { return "request failed" }
    return string(env["error"])
}

// Format a per-token USD price string as "$X/1k". Raw on parse failure.
price1k := fn(raw) {
    if (raw == null) { return "?" }
    s := string(raw)
    p := try(float(s))
    if (!p[0]) { return s }
    return "$" + string(p[1] * 1000) + "/1k"
}

call_shell := fn(ctx, command) {
    by := ctx["base_by"]
    if (by == null) { by = ctx["by_name"] }
    if (by == null) { return "Error: no tools" }
    return tools.call_tool(by, "shell", json.stringify({"command": command}))
}

models_run := fn(ctx, args) {
    cache := ctx["models_cache"]
    if (cache == null || len(cache) == 0) {
        cli := ctx["cli"]
        ml := cli["models"]
        if (ml == null) { return "Error: cli has no models fn" }
        r := ml(null)
        if (r == null || r["ok"] != true) {
            return "Error: " + chat_error(r)
        }
        ctx["models_cache"] = r["models"]
    }
    models := ctx["models_cache"]
    total := len(models)
    if (total == 0) { return "models: (empty)" }
    cap := total
    if (cap > 40) { cap = 40 }
    lines := ["models (" + string(total) + "):"]
    for (i := 0; i < cap; i += 1) {
        m := models[i]
        id := ""
        cl := "?"
        pp := "?"
        cp := "?"
        if (type(m) == "HASH") {
            if (m["id"] != null) { id = string(m["id"]) }
            if (m["context_length"] != null) { cl = string(m["context_length"]) }
            pr := m["pricing"]
            if (type(pr) == "HASH") {
                pp = price1k(pr["prompt"])
                cp = price1k(pr["completion"])
            }
        }
        if (len(id) > 60) { id = str.slice(id, 0, 60) }
        lines = arr.push(lines, id + " ctx:" + cl + " " + pp + " prompt," + cp + " completion")
    }
    return str.join(lines, "\n")
}

model_run := fn(ctx, args) {
    want := str.trim(args)
    if (want == "") {
        pf := ctx["on_picker"]
        if (pf != null) {
            r := try(pf("model"))
            if (!r[0]) { return "Error: " + string(r[1]) }
            return string(r[1])
        }
        return "usage: /model <id>"
    }
    cli := ctx["cli"]
    sm := cli["set_model"]
    if (sm == null) { return "Error: cli does not support set_model" }
    r := try(sm(want))
    if (!r[0]) { return "Error: " + string(r[1]) }
    ui := ctx["ui"]
    if (ui != null) { ui["model"] = want }
    return "model -> " + want
}

// cost_line_for(ctx, cli) -> "est cost: $D.HHHH (est)" or "est cost: n/a".
// Prefers the /models cache pricing (USD per token) for the active model,
// falling back to the built-in static price table (USD per 1M tokens).
cost_line_for := fn(ctx, cli) {
    mid := ""
    if (cli != null && cli["model"] != null) { mid = string(cli["model"]) }
    p := 0
    c := 0
    st := null
    if (cli != null) { st = cli["stats"] }
    if (type(st) == "HASH") {
        if (type(st["prompt"]) == "INTEGER") { p = st["prompt"] }
        if (type(st["completion"]) == "INTEGER") { c = st["completion"] }
    }
    cache := null
    if (type(ctx) == "HASH") { cache = ctx["models_cache"] }
    if (type(cache) == "ARRAY" && mid != "") {
        for (i := 0; i < len(cache); i += 1) {
            m := cache[i]
            if (type(m) != "HASH" || m["id"] == null || string(m["id"]) != mid) { continue }
            pr := m["pricing"]
            if (type(pr) != "HASH" || pr["prompt"] == null || pr["completion"] == null) { continue }
            a := try(float(string(pr["prompt"])))
            b := try(float(string(pr["completion"])))
            if (a[0] && b[0]) {
                total := float(p) * a[1] + float(c) * b[1]
                return "est cost: " + pricing.fmt_cost(total) + " (est)"
            }
        }
    }
    ec := pricing.estimate(mid, p, c)
    if (ec != null) {
        return "est cost: " + pricing.fmt_cost(ec) + " (est)"
    }
    return "est cost: n/a"
}

stats_run := fn(ctx, args) {
    cli := ctx["cli"]
    st := cli["stats"]
    p := 0
    c := 0
    n := 0
    if (type(st) == "HASH") {
        if (type(st["prompt"]) == "INTEGER") { p = st["prompt"] }
        if (type(st["completion"]) == "INTEGER") { c = st["completion"] }
        if (type(st["calls"]) == "INTEGER") { n = st["calls"] }
    }
    mid := ""
    if (cli["model"] != null) { mid = string(cli["model"]) }
    cost_line := cost_line_for(ctx, cli)
    last := "last: (none)"
    lu := cli["last_usage"]
    if (type(lu) == "HASH") {
        last = "last: " + json.stringify(lu)
    }
    return "model: " + mid + "\ntokens: " + string(p) + " prompt / " + string(c) + " completion in " + string(n) + " calls\n" + cost_line + " " + last
}

status_run := fn(ctx, args) {
    cli := ctx["cli"]
    lines := []
    mid := ""
    if (cli != null && cli["model"] != null) { mid = string(cli["model"]) }
    lines = arr.push(lines, "model: " + mid)
    pol := ctx["policy"]
    if (pol != null) {
        lines = arr.push(lines, string(approvals.describe(pol)))
    }
    guard := ctx["guard"]
    if (guard != null && guard["sandbox"] != null) {
        smode := string(guard["sandbox"])
        if (smode == "danger-full-access") {
            lines = arr.push(lines, "sandbox: danger-full-access (unrestricted)")
        } else {
            impl := "advisory"
            if (guard["sandbox_impl"] != null) { impl = string(guard["sandbox_impl"]) }
            lines = arr.push(lines, "sandbox: " + smode + " (" + impl + ")")
        }
    }
    ui := ctx["ui"]
    if (ui != null && ui["cwd"] != null) {
        lines = arr.push(lines, "cwd: " + string(ui["cwd"]))
    }
    sess := ctx["session"]
    if (sess != null && sess["id"] != null) {
        lines = arr.push(lines, "session: " + string(sess["id"]))
    }
    lines = arr.push(lines, cost_line_for(ctx, cli))
    br := call_shell(ctx, "git rev-parse --abbrev-ref HEAD 2>/dev/null")
    if (!str.starts_with(br, "Error") && !str.contains(br, "fatal")) {
        first := str.split(str.trim(br), "\n")
        if (len(first) > 1) {
            line1 := first[1]
            if (line1 != null && str.trim(line1) != "") {
                lines = arr.push(lines, "branch: " + str.trim(line1))
            }
        }
    }
    pl := ctx["plan"]
    if (pl != null && type(pl["steps"]) == "ARRAY") {
        done := 0
        steps := pl["steps"]
        for (i := 0; i < len(steps); i += 1) {
            it := steps[i]
            if (type(it) == "HASH" && it["status"] == "completed") { done += 1 }
        }
        lines = arr.push(lines, "plan: " + string(done) + "/" + string(len(steps)) + " steps completed")
    }
    return str.join(lines, "\n")
}

clear_run := fn(ctx, args) {
    ui := ctx["ui"]
    if (ui != null) { ui["log"] = [] }
    return "cleared"
}

compact_run := fn(ctx, args) {
    ag := ctx["ag"]
    conv := ag["conversation"]
    if (conv == null) { return "Error: no conversation" }
    list := conv["to_api"](conv)
    if (type(list) != "ARRAY") { return "Error: unexpected conversation shape" }
    before := len(list)
    if (before <= 6) { return "nothing to compact" }
    head := list[0]
    // keep the last 4 messages, stepping back over leading tool replies so
    // tool_call/assistant pairs stay intact
    start := before - 4
    for (start > 1) {
        m := list[start]
        if (type(m) != "HASH" || m["role"] != "tool") { break }
        start -= 1
    }
    tail := arr.slice(list, start, before)
    middle := arr.slice(list, 1, start)
    digest := json.stringify(middle)
    if (len(digest) > 16000) { digest = str.slice(digest, 0, 16000) + "...[truncated]" }
    cli := ctx["cli"]
    prompt := [
        {"role": "system", "content": "You summarize coding conversations. Keep file paths, decisions, applied patches and open tasks. Be terse."},
        {"role": "user", "content": "Summarize this conversation for context compaction:\n" + digest}
    ]
    env := cli["chat"](prompt, {"temperature": 0.3})
    txt := chat_text(env)
    if (txt == "") { return "Error: " + chat_error(env) }
    updated := [head, {"role": "user", "content": "[compacted summary] " + txt}]
    for (i := 0; i < len(tail); i += 1) {
        updated = arr.push(updated, tail[i])
    }
    conv["messages"] = updated
    return "compacted " + string(before) + " -> " + string(len(updated)) + " messages"
}

btw_run := fn(ctx, args) {
    q := ""
    if (args != null) { q = str.trim(args) }
    if (q == "") { return "usage: /btw <question>" }
    ag := ctx["ag"]
    conv := ag["conversation"]
    if (conv == null) { return "Error: no conversation" }
    list := conv["to_api"](conv)
    if (type(list) != "ARRAY") { return "Error: unexpected conversation shape" }
    start := 0
    if (len(list) > 10) { start = len(list) - 10 }
    base := arr.slice(list, start, len(list))
    withq := arr.push(base, {"role": "user", "content": q})
    cli := ctx["cli"]
    env := cli["chat"](withq, {})
    txt := chat_text(env)
    if (txt == "") { return "Error: " + chat_error(env) }
    return "btw: " + txt
}

init_run := fn(ctx, args) {
    by := ctx["base_by"]
    if (by == null) { by = ctx["by_name"] }
    if (by == null) { return "Error: no tools" }
    ui := ctx["ui"]
    cwd := ""
    if (ui != null && ui["cwd"] != null) { cwd = string(ui["cwd"]) }
    listing := tools.call_tool(by, "glob", json.stringify({"pattern": "*"}))
    files_text := listing
    g := try(json.parse(listing))
    if (g[0] && type(g[1]) == "ARRAY") {
        items := g[1]
        if (len(items) > 30) { items = arr.slice(items, 0, 30) }
        files_text = str.join(items, "\n")
    }
    content := "# AGENTS.md\n\n<!-- Project notes for coding agents (written by /init). -->\n\n## Project\ncwd: " + cwd + "\n\n## Files\n" + files_text + "\n\n## Conventions\n- Describe build/test commands here.\n- Describe code style and review expectations here.\n"
    w := tools.call_tool(by, "write_file", json.stringify({"path": "AGENTS.md", "content": content}))
    if (str.starts_with(w, "Error")) { return w }
    return "wrote AGENTS.md"
}

bang_run := fn(ctx, cmdrest) {
    rest := ""
    if (cmdrest != null) { rest = str.trim(cmdrest) }
    if (rest == "") { return "usage: !<command>" }
    return call_shell(ctx, rest)
}

// tree_run implements "/tree" over the ctx tree (built by the harness via
// pi.session_load) plus the agent conversation: "" lists branches;
// "checkout <b>" restores a branch into the conversation and switches;
// "branch <b>" snapshots the conversation to a new branch and switches.
tree_run := fn(ctx, args) {
    tree := ctx["tree"]
    if (tree == null) { return "Error: no tree in ctx" }
    a := ""
    if (args != null) { a = str.trim(string(args)) }
    if (a == "") { return pi.tree_list(tree) }
    raw := str.split(a, " ")
    words := []
    for (i := 0; i < len(raw); i += 1) {
        if (raw[i] != "") { words = arr.push(words, raw[i]) }
    }
    if (len(words) == 0) { return pi.tree_list(tree) }
    op := words[0]
    name := ""
    if (len(words) > 1) { name = words[1] }
    if (op == "checkout") {
        if (name == "") { return "usage: /tree checkout <branch>" }
        ag := ctx["ag"]
        if (ag == null) { return "Error: no conversation" }
        conv := ag["conversation"]
        if (conv == null) { return "Error: no conversation" }
        r := pi.tree_checkout(tree, name, conv)
        ui := ctx["ui"]
        if (ui != null) { ui["branch"] = tree["current"] }
        return r
    }
    if (op == "branch") {
        if (name == "") { return "usage: /tree branch <name>" }
        ag2 := ctx["ag"]
        if (ag2 == null) { return "Error: no conversation" }
        conv2 := ag2["conversation"]
        if (conv2 == null) { return "Error: no conversation" }
        r2 := pi.tree_branch(tree, name, conv2)
        ui2 := ctx["ui"]
        if (ui2 != null) { ui2["branch"] = tree["current"] }
        return r2
    }
    return "usage: /tree [checkout <branch> | branch <name>]"
}

approval_modes := fn() {
    return ["untrusted", "on-failure", "on-request", "never"]
}

approvals_run := fn(ctx, args) {
    pol := ctx["policy"]
    if (pol == null) { return "Error: no policy in ctx" }
    want := str.trim(args)
    modes := approval_modes()
    if (want == "") {
        cur := pol["mode"]
        idx := 0
        for (i := 0; i < len(modes); i += 1) {
            if (modes[i] == cur) { idx = i }
        }
        want = modes[(idx + 1) % 4]
    }
    ok := false
    for (i := 0; i < len(modes); i += 1) {
        if (modes[i] == want) { ok = true }
    }
    if (!ok) { return "Error: unknown mode " + want + " (untrusted|on-failure|on-request|never)" }
    pol["mode"] = want
    return string(approvals.describe(pol))
}

sandbox_modes := fn() {
    return ["read-only", "workspace-write", "danger-full-access"]
}

sandbox_run := fn(ctx, args) {
    guard := ctx["guard"]
    if (guard == null) { return "Error: no guard in ctx" }
    want := str.trim(args)
    modes := sandbox_modes()
    if (want == "") {
        cur := guard["sandbox"]
        idx := 1
        for (i := 0; i < len(modes); i += 1) {
            if (modes[i] == cur) { idx = i }
        }
        want = modes[(idx + 1) % 3]
    }
    ok := false
    for (i := 0; i < len(modes); i += 1) {
        if (modes[i] == want) { ok = true }
    }
    if (!ok) { return "Error: unknown sandbox " + want + " (read-only|workspace-write|danger-full-access)" }
    guard["sandbox"] = want
    return "sandbox -> " + want
}

diff_run := fn(ctx, args) {
    out := call_shell(ctx, "git --no-pager diff")
    if (str.starts_with(out, "Error")) { return out }
    if (str.starts_with(out, "exit 128") || str.starts_with(out, "exit 129")) {
        return "not a git repository"
    }
    body := out
    if (str.starts_with(out, "exit 0\n")) { body = str.slice(out, 7, len(out)) }
    if (str.trim(body) == "") {
        return "no changes"
    }
    if (len(body) > 30000) {
        n := len(body) - 30000
        body = str.slice(body, 0, 30000) + "\n...[truncated " + string(n) + " chars]"
    }
    return body
}

review_run := fn(ctx, args) {
    raw := call_shell(ctx, "git --no-pager diff")
    if (str.starts_with(raw, "Error")) { return raw }
    if (str.starts_with(raw, "exit 128") || str.starts_with(raw, "exit 129")) {
        return "not a git repository"
    }
    diff := raw
    if (str.starts_with(diff, "exit 0\n")) { diff = str.slice(diff, 7, len(diff)) }
    if (str.trim(diff) == "") { return "nothing to review (no diff)" }
    if (len(diff) > 24000) { diff = str.slice(diff, 0, 24000) + "...[truncated]" }
    cli := ctx["cli"]
    prompt := [
        {"role": "system", "content": "You are a meticulous code reviewer. Point out real bugs, race conditions, missing edge cases and missing tests as concise markdown bullets. Do not restate the diff."},
        {"role": "user", "content": "Review this diff:\n" + diff}
    ]
    env := cli["chat"](prompt, {"temperature": 0.3})
    txt := chat_text(env)
    if (txt == "") { return "Error: " + chat_error(env) }
    return txt
}

new_run := fn(ctx, args) {
    nf := ctx["on_new"]
    if (nf == null) { return "Error: new session not wired" }
    r := try(nf())
    if (!r[0]) { return "Error: " + string(r[1]) }
    return string(r[1])
}

resume_run := fn(ctx, args) {
    want := str.trim(args)
    rf := ctx["on_resume"]
    if (want != "") {
        if (rf == null) { return "Error: resume not wired" }
        r := try(rf(want))
        if (!r[0]) { return "Error: " + string(r[1]) }
        return string(r[1])
    }
    ap := ctx["app"]
    pf := ctx["on_picker"]
    if (ap != null && ap["tty"] == true && pf != null) {
        r := try(pf("session"))
        if (!r[0]) { return "Error: " + string(r[1]) }
        return string(r[1])
    }
    if (rf != null) {
        r2 := try(rf("latest"))
        if (!r2[0]) { return "Error: " + string(r2[1]) }
        return string(r2[1])
    }
    sessions := session.list()
    if (type(sessions) != "ARRAY" || len(sessions) == 0) {
        return "sessions: (none yet)"
    }
    cap := len(sessions)
    if (cap > 10) { cap = 10 }
    lines := ["recent sessions (newest first):"]
    for (i := 0; i < cap; i += 1) {
        s := sessions[i]
        if (type(s) != "HASH") { continue }
        id := ""
        pv := ""
        if (s["id"] != null) { id = string(s["id"]) }
        if (s["preview"] != null) { pv = string(s["preview"]) }
        if (len(pv) > 60) { pv = str.slice(pv, 0, 60) }
        lines = arr.push(lines, id + "  " + pv)
    }
    lines = arr.push(lines, "resume with /resume <id> or /resume latest")
    return str.join(lines, "\n")
}

undo_run := fn(ctx, args) {
    sess := ctx["session"]
    sid := "nosession"
    if (sess != null && sess["id"] != null) { sid = string(sess["id"]) }
    base := ctx["ck_base"]
    if (base == null || type(base) != "STRING" || base == "") { return "Error: checkpoints not wired" }
    want := str.trim(args)
    if (want == "list") {
        ls := try(checkpoints.list_turns(sid, base))
        if (!ls[0] || len(ls[1]) == 0) { return "no checkpoints for this session" }
        return str.join(ls[1], "\n")
    }
    r := try(checkpoints.undo_last(sid, base))
    if (!r[0]) { return "Error: " + string(r[1]) }
    return string(r[1])
}

quit_run := fn(ctx, args) {
    ui := ctx["ui"]
    if (ui != null) {
        ui["quit"] = true
    }
    return "bye"
}

pub builtin_names := fn() {
    return ["/help", "/models", "/model", "/stats", "/status", "/clear", "/compact", "/btw", "/init", "/new", "/diff", "/review", "/resume", "/approvals", "/sandbox", "/tree", "/undo", "/quit"]
}

pub all_commands := fn() {
    list := [
        make_command("models", "list available models (cached)", models_run),
        make_command("model", "switch model: /model <id>", model_run),
        make_command("stats", "show token usage and est. cost", stats_run),
        make_command("status", "model, approvals, sandbox, cwd, session", status_run),
        make_command("clear", "clear the transcript", clear_run),
        make_command("compact", "summarize history into fewer messages", compact_run),
        make_command("btw", "side question, history untouched: /btw <q>", btw_run),
        make_command("init", "write AGENTS.md project notes", init_run),
        make_command("new", "start a fresh session", new_run),
        make_command("diff", "show git diff for review", diff_run),
        make_command("review", "review the current diff with the model", review_run),
        make_command("resume", "resume a session: /resume [id|latest]; picker with no id in the TUI", resume_run),
        make_command("undo", "restore files from the last tool turn: /undo [list]", undo_run),
        make_command("approvals", "get/set approvals: /approvals [mode]", approvals_run),
        make_command("sandbox", "get/set sandbox: /sandbox [mode]", sandbox_run),
        make_command("tree", "list/switch branches: /tree [checkout|branch <b>]", tree_run),
        make_command("quit", "exit zodex (same as :q)", quit_run),
        make_command("!", "run shell: !<cmd>", bang_run)
    ]
    help_run := fn(ctx, args) {
        lines := ["/help - list commands"]
        for (i := 0; i < len(list); i += 1) {
            c := list[i]
            nm := c["name"]
            label := "/" + nm
            if (nm == "!") { label = "!<cmd>" }
            lines = arr.push(lines, label + " - " + c["hint"])
        }
        pm := ctx["prompts"]
        if (type(pm) == "HASH") {
            ks := hash.keys(pm)
            prows := []
            for (k := 0; k < len(ks); k += 1) {
                if (!arr.contains(builtin_names(), "/" + ks[k])) {
                    prows = arr.push(prows, "/" + ks[k] + " - prompt from .md file")
                }
            }
            if (len(prows) > 0) {
                lines = arr.push(lines, "")
                lines = arr.push(lines, "prompts:")
                for (k := 0; k < len(prows); k += 1) {
                    lines = arr.push(lines, prows[k])
                }
            }
        }
        return str.join(lines, "\n")
    }
    out := [make_command("help", "list commands", help_run)]
    for (k := 0; k < len(list); k += 1) {
        out = arr.push(out, list[k])
    }
    return out
}
