// coding_tools.zd — pure-Zod coding tools for Zodex.
//
// make_coding_tools(cwd, opts) -> [read_file, write_file, edit, glob,
//   grep, shell, apply_patch, update_plan]
// make_readonly_tools(cwd)    -> [read_file, glob, grep, update_plan]
//
// opts (hash or null):
//   "allow_exec" (bool, default true)   disable the shell tool
//   "max_bytes"  (int,  default 200000) tool output cap
//   "guard"      (hash) shared sandbox state {"sandbox": mode}; mutating
//                guard["sandbox"] changes behavior live. Modes:
//                "workspace-write" (default), "read-only",
//                "danger-full-access". This is an advisory path guard,
//                NOT an OS-level sandbox.
//   "plan_state" (hash) shared {"steps":[...]} used by update_plan so the
//                UI can render the checklist; a private one is used when
//                omitted.
//
// All tools return strings; failures are "Error: ..." strings. Never halt.

import "tools.zd" as tools
import "apply_patch.zd" as apply_patch
import "std/fs" as fs
import "std/str" as str
import "std/array" as arr
import "std/json" as json
import "std/process" as process
import "sandbox.zd" as sandbox

pub SANDBOX_DEFAULT := "workspace-write"

pub valid_sandbox := fn(mode) {
    if (mode == "read-only" || mode == "workspace-write" || mode == "danger-full-access") {
        return true
    }
    return false
}

// make_guard(mode) builds a fresh shared guard hash.
pub make_guard := fn(mode) {
    m := mode
    if (!valid_sandbox(m)) { m = SANDBOX_DEFAULT }
    return {"sandbox": m}
}

// make_plan_state() builds a fresh shared plan hash.
pub make_plan_state := fn() {
    return {"steps": []}
}

pub make_coding_tools := fn(cwd, opts) {
    if (opts == null) { opts = {} }

    allow_exec := true
    if (opts["allow_exec"] != null) { allow_exec = opts["allow_exec"] }
    max_bytes := 200000
    if (opts["max_bytes"] != null && type(opts["max_bytes"]) == "INTEGER") { max_bytes = opts["max_bytes"] }

    exec_wrap := null
    if (opts["exec_wrap"] != null && type(opts["exec_wrap"]) == "STRING" && opts["exec_wrap"] != "") {
        exec_wrap = opts["exec_wrap"]
    }
    sandbox_binds := []
    if (type(opts["sandbox_binds"]) == "ARRAY") { sandbox_binds = opts["sandbox_binds"] }

    guard := opts["guard"]
    if (type(guard) != "HASH") { guard = make_guard(null) }

    plan_state := opts["plan_state"]
    if (type(plan_state) != "HASH") { plan_state = make_plan_state() }

    sandbox_mode := fn() {
        s := guard["sandbox"]
        if (!valid_sandbox(s)) { s = SANDBOX_DEFAULT }
        return s
    }

    // join_path resolves a user-supplied path; absolute paths only pass
    // through under danger-full-access.
    join_path := fn(p) {
        if (sandbox_mode() == "danger-full-access" && str.starts_with(p, "/")) {
            return p
        }
        return cwd + "/" + p
    }

    // path_err(p, for_write): null when usable, else an "Error: ..." string.
    path_err := fn(p, for_write) {
        if (p == null || type(p) != "STRING" || p == "") {
            return "Error: path required"
        }
        s := sandbox_mode()
        if (s != "danger-full-access") {
            if (str.starts_with(p, "/")) {
                return "Error: absolute path blocked by sandbox: " + p
            }
            parts := str.split(p, "/")
            for (i := 0; i < len(parts); i += 1) {
                if (parts[i] == "..") {
                    return "Error: path escapes sandbox: " + p
                }
            }
        }
        if (for_write == true && s == "read-only") {
            return "Error: sandbox \"read-only\" blocks writes"
        }
        return null
    }

    base_name := fn(rel) {
        parts := str.split(rel, "/")
        return parts[len(parts) - 1]
    }

    // Strip leading "**/" segments from a glob pattern.
    strip_starslash := fn(p) {
        out := p
        for (str.starts_with(out, "**/")) {
            out = str.slice(out, 3, len(out))
        }
        return out
    }

    // Match a file (basename name, cwd-relative rel path) against pattern.
    // "*" / "**" match everything; "*.<suf>" is a suffix match;
    // "pre*" is a prefix match; other "*" patterns strip stars and
    // contains-match; otherwise exact or contains match.
    match_pat := fn(name, rel, pat) {
        if (pat == "*" || pat == "**" || pat == "**/*") {
            return true
        }
        p := strip_starslash(pat)
        if (p == "*" || p == "") {
            return true
        }
        if (str.starts_with(p, "*.")) {
            rest := str.slice(p, 2, len(p))
            if (!str.contains(rest, "*")) {
                return str.ends_with(name, "." + rest)
            }
        }
        if (str.ends_with(p, "*")) {
            pre := str.slice(p, 0, len(p) - 1)
            if (!str.contains(pre, "*")) {
                core := pre
                for (str.starts_with(core, "*")) {
                    core = str.slice(core, 1, len(core))
                }
                if (core == "") {
                    return true
                }
                return str.starts_with(name, core) || str.starts_with(rel, core)
            }
        }
        if (str.contains(p, "*")) {
            core := str.replace(p, "*", "")
            core = str.replace(core, "/", "")
            if (core == "") {
                return true
            }
            return str.contains(name, core) || str.contains(rel, core)
        }
        if (name == p || rel == p) {
            return true
        }
        return str.contains(name, p) || str.contains(rel, p)
    }

    // Recursively list files under base. root is base's cwd-relative path
    // ("" when base == cwd). Returns cwd-relative paths. Depth capped at 8,
    // entries capped at 200. Skips dot-dirs and node_modules/.git/target.
    walk_files := fn(base, root) {
        out := []
        dirs := [base]
        rels := [root]
        depths := [0]
        for (len(dirs) > 0) {
            idx := len(dirs) - 1
            cur := dirs[idx]
            cur_rel := rels[idx]
            dep := depths[idx]
            dirs = arr.slice(dirs, 0, idx)
            rels = arr.slice(rels, 0, idx)
            depths = arr.slice(depths, 0, idx)
            if (dep > 8) {
                continue
            }
            lr := try(fs.ls(cur))
            if (!lr[0]) {
                continue
            }
            entries := lr[1]
            for (i := 0; i < len(entries); i += 1) {
                name := entries[i]
                if (str.starts_with(name, ".")) {
                    continue
                }
                if (name == "node_modules" || name == ".git" || name == "target") {
                    continue
                }
                full := cur + "/" + name
                rel := name
                if (cur_rel != "") {
                    rel = cur_rel + "/" + name
                }
                sr := try(fs.stat(full))
                if (!sr[0]) {
                    continue
                }
                st := sr[1]
                if (st["is_dir"]) {
                    if (dep < 8) {
                        dirs = arr.push(dirs, full)
                        rels = arr.push(rels, rel)
                        depths = arr.push(depths, dep + 1)
                    }
                } else {
                    out = arr.push(out, rel)
                    if (len(out) >= 200) {
                        return out
                    }
                }
            }
        }
        return out
    }

    // Resolve optional dir arg to [error, base, root].
    resolve_base := fn(d) {
        if (d == null) { d = "" }
        if (type(d) != "STRING") {
            return ["Error: dir must be a string", null, null]
        }
        if (d == "") {
            return [null, cwd, ""]
        }
        e := path_err(d, false)
        if (e != null) {
            return [e, null, null]
        }
        if (sandbox_mode() == "danger-full-access" && str.starts_with(d, "/")) {
            return [null, d, d]
        }
        return [null, cwd + "/" + d, d]
    }

    read_file := tools.make_tool(
        "read_file",
        "Read a file. Plain call returns content (capped at max_bytes). With offset/limit returns at most limit lines (max 4000) starting at 1-based line offset, each prefixed with \"  N| \".",
        {
            "type": "object",
            "properties": {
                "path": {"type": "string", "description": "file path relative to cwd"},
                "offset": {"type": "integer", "description": "1-based first line (optional)"},
                "limit": {"type": "integer", "description": "max lines to return (optional)"}
            },
            "required": ["path"]
        },
        fn(args) {
            p := args["path"]
            e := path_err(p, false)
            if (e != null) { return e }
            full := join_path(p)
            r := try(fs.read_file(full))
            if (!r[0]) {
                return "Error: " + r[1]
            }
            c := r[1]
            off := args["offset"]
            lim := args["limit"]
            if (off != null || lim != null) {
                o := 1
                if (type(off) == "INTEGER" && off > 0) { o = off }
                l := 2000
                if (type(lim) == "INTEGER" && lim > 0) { l = lim }
                if (l > 4000) { l = 4000 }
                lines := str.split(c, "\n")
                total := len(lines)
                start := o - 1
                if (start > total) { start = total }
                end := start + l
                if (end > total) { end = total }
                out := []
                for (i := start; i < end; i += 1) {
                    numstr := string(i + 1)
                    padn := 6 - len(numstr)
                    if (padn < 1) { padn = 1 }
                    out = arr.push(out, str.repeat(" ", padn) + numstr + "| " + lines[i])
                }
                body := str.join(out, "\n")
                if (end < total) {
                    body = body + "\n...[showing lines " + string(start + 1) + "-" + string(end) + " of " + string(total) + "]"
                }
                return body
            }
            if (len(c) > max_bytes) {
                n := len(c) - max_bytes
                c = str.slice(c, 0, max_bytes) + "\n...[truncated " + string(n) + " chars]"
            }
            return c
        }
    )

    mkdir_parents := fn(p) {
        parts := str.split(p, "/")
        if (len(parts) > 1) {
            d := str.join(arr.slice(parts, 0, len(parts) - 1), "/")
            if (d != "" && d != p) {
                ignored := try(fs.mkdir(join_path(d)))
            }
        }
        return null
    }

    write_file := tools.make_tool(
        "write_file",
        "Write content to a file, creating parent directories as needed. Overwrites existing files.",
        {
            "type": "object",
            "properties": {
                "path": {"type": "string", "description": "file path relative to cwd"},
                "content": {"type": "string", "description": "file content to write"}
            },
            "required": ["path", "content"]
        },
        fn(args) {
            p := args["path"]
            e := path_err(p, true)
            if (e != null) { return e }
            content := args["content"]
            if (content == null || type(content) != "STRING") {
                return "Error: content required"
            }
            ignored := mkdir_parents(p)
            full := join_path(p)
            w := try(fs.write_file(full, content))
            if (!w[0]) {
                return "Error: " + w[1]
            }
            return "wrote " + full + " (" + string(len(content)) + " bytes)"
        }
    )

    edit := tools.make_tool(
        "edit",
        "Replace the first occurrence of old_string with new_string in a file. old_string must be non-empty and must match exactly.",
        {
            "type": "object",
            "properties": {
                "path": {"type": "string", "description": "file path relative to cwd"},
                "old_string": {"type": "string", "description": "text to find (first occurrence only)"},
                "new_string": {"type": "string", "description": "replacement text"}
            },
            "required": ["path", "old_string", "new_string"]
        },
        fn(args) {
            p := args["path"]
            e := path_err(p, true)
            if (e != null) { return e }
            old := args["old_string"]
            news := args["new_string"]
            if (old == null || type(old) != "STRING" || old == "") {
                return "Error: old_string not found"
            }
            if (news == null || type(news) != "STRING") {
                return "Error: new_string required"
            }
            full := join_path(p)
            r := try(fs.read_file(full))
            if (!r[0]) {
                return "Error: " + r[1]
            }
            content := r[1]
            if (!str.contains(content, old)) {
                return "Error: old_string not found"
            }
            idx := str.index_of(content, old)
            before := str.slice(content, 0, idx)
            after := str.slice(content, idx + len(old), len(content))
            updated := before + news + after
            w := try(fs.write_file(full, updated))
            if (!w[0]) {
                return "Error: " + w[1]
            }
            return "edited " + full + " replaced " + string(len(old)) + " chars"
        }
    )

    glob := tools.make_tool(
        "glob",
        "List files under cwd (recursive, depth 8, max 200) matching pattern. Use '*' for all, '*.ext' for suffix, 'pre*' for prefix.",
        {
            "type": "object",
            "properties": {
                "pattern": {"type": "string", "description": "glob pattern, e.g. '*.zd'"},
                "dir": {"type": "string", "description": "optional subdirectory to search"}
            },
            "required": ["pattern"]
        },
        fn(args) {
            pat := args["pattern"]
            if (pat == null || type(pat) != "STRING" || pat == "") {
                return "Error: pattern required"
            }
            br := resolve_base(args["dir"])
            if (br[0] != null) {
                return br[0]
            }
            files := walk_files(br[1], br[2])
            out := []
            for (i := 0; i < len(files); i += 1) {
                rel := files[i]
                if (match_pat(base_name(rel), rel, pat)) {
                    out = arr.push(out, rel)
                }
                if (len(out) >= 200) {
                    break
                }
            }
            if (len(out) == 0) {
                return "(no matches)"
            }
            return json.stringify(out)
        }
    )

    grep := tools.make_tool(
        "grep",
        "Search file contents under cwd for a substring. Returns up to 50 hits as full_path:lineno: line. Skips binary and oversized files.",
        {
            "type": "object",
            "properties": {
                "pattern": {"type": "string", "description": "substring to search for"},
                "dir": {"type": "string", "description": "optional subdirectory to search"},
                "include": {"type": "string", "description": "optional file filter, e.g. '*.zd'"}
            },
            "required": ["pattern"]
        },
        fn(args) {
            pat := args["pattern"]
            if (pat == null || type(pat) != "STRING" || pat == "") {
                return "Error: pattern required"
            }
            br := resolve_base(args["dir"])
            if (br[0] != null) {
                return br[0]
            }
            inc := args["include"]
            if (inc == null) { inc = "" }
            if (inc != "" && type(inc) != "STRING") {
                return "Error: include must be a string"
            }
            files := walk_files(br[1], br[2])
            hits := []
            for (i := 0; i < len(files); i += 1) {
                if (i >= 100) {
                    break
                }
                rel := files[i]
                if (inc != "") {
                    if (!match_pat(base_name(rel), rel, inc)) {
                        continue
                    }
                }
                full := br[1] + "/" + rel
                fr := try(fs.read_file(full))
                if (!fr[0]) {
                    continue
                }
                content := fr[1]
                if (len(content) > 200000) {
                    content = str.slice(content, 0, 200000)
                }
                if (str.contains(content, "\x00")) {
                    continue
                }
                lines := str.split(content, "\n")
                for (j := 0; j < len(lines); j += 1) {
                    line := lines[j]
                    if (str.contains(line, pat)) {
                        if (len(line) > 300) {
                            line = str.slice(line, 0, 300)
                        }
                        hits = arr.push(hits, full + ":" + string(j + 1) + ": " + line)
                        if (len(hits) >= 50) {
                            break
                        }
                    }
                }
                if (len(hits) >= 50) {
                    break
                }
            }
            if (len(hits) == 0) {
                return "(no matches)"
            }
            return str.join(hits, "\n")
        }
    )

    // Commands allowed by the advisory "read-only" sandbox for the shell.
    read_only_cmd_ok := fn(cmd) {
        raw := str.split(str.trim(cmd), " ")
        toks := []
        for (i := 0; i < len(raw); i += 1) {
            if (raw[i] != "") { toks = arr.push(toks, raw[i]) }
        }
        if (len(toks) == 0) { return false }
        t0 := toks[0]
        if (t0 == "git") {
            if (len(toks) < 2) { return false }
            t1 := toks[1]
            if (t1 == "status" || t1 == "diff" || t1 == "log" || t1 == "branch" || t1 == "show" || t1 == "rev-parse" || t1 == "remote" || t1 == "describe" || t1 == "blame" || t1 == "ls-files") {
                return true
            }
            return false
        }
        simple := ["ls", "cat", "pwd", "head", "tail", "wc", "which", "echo", "grep", "rg", "find", "tree", "stat", "file", "diff", "sed", "awk", "sort", "uniq", "date", "env", "uname"]
        return arr.contains(simple, t0)
    }

    shell := tools.make_tool(
        "shell",
        "Run a shell command (via sh -c) with cwd set. Returns exit code, stdout and stderr; very long output is truncated head+tail. Optional timeout_ms (default 30000, max 120000) and workdir.",
        {
            "type": "object",
            "properties": {
                "command": {"type": "string", "description": "shell command to run"},
                "timeout_ms": {"type": "integer", "description": "timeout in milliseconds, default 30000, clamped to 1..120000"},
                "workdir": {"type": "string", "description": "optional working directory"}
            },
            "required": ["command"]
        },
        fn(args) {
            if (!allow_exec) {
                return "Error: exec disabled"
            }
            cmd := args["command"]
            if (cmd == null || type(cmd) != "STRING" || cmd == "") {
                return "Error: command required"
            }
            ms := args["timeout_ms"]
            if (ms == null) { ms = 30000 }
            if (type(ms) != "INTEGER") {
                return "Error: timeout_ms must be an integer"
            }
            if (ms < 1) { ms = 1 }
            if (ms > 120000) { ms = 120000 }
            wd := cwd
            wdarg := args["workdir"]
            if (wdarg != null && type(wdarg) == "STRING" && wdarg != "") {
                we := path_err(wdarg, false)
                if (we != null) { return we }
                wd = join_path(wdarg)
            }
            if (sandbox_mode() == "read-only" && !read_only_cmd_ok(cmd)) {
                return "Error: sandbox \"read-only\" blocks shell command: " + cmd
            }
            r := null
            if (exec_wrap != null && sandbox_mode() != "danger-full-access") {
                wargs := sandbox.wrap_argv(sandbox_mode(), cwd, wd, sandbox_binds, cmd)
                r = try(process.exec(exec_wrap, wargs, {"cwd": wd, "timeout_ms": ms}))
            } else {
                r = try(process.shell(cmd, {"cwd": wd, "timeout_ms": ms}))
            }
            if (!r[0]) {
                return "Error: " + r[1]
            }
            h := r[1]
            out := "exit " + string(h["code"]) + "\n" + h["stdout"]
            se := h["stderr"]
            if (se != null && se != "") {
                out = out + "\n[stderr]\n" + se
            }
            if (h["timed_out"]) {
                out = out + "\n[timed out]"
            }
            if (len(out) > max_bytes) {
                head_keep := (max_bytes * 3) / 5
                tail_keep := max_bytes - head_keep
                n := len(out) - max_bytes
                out = str.slice(out, 0, head_keep) + "\n...[truncated " + string(n) + " chars]...\n" + str.slice(out, len(out) - tail_keep, len(out))
            }
            return out
        }
    )

    apply_patch_tool := tools.make_tool(
        "apply_patch",
        "Apply a Codex-style patch. Format: *** Begin Patch ... *** End Patch with *** Add File / *** Update File (optional @@ anchors, - / + lines, *** Move to:) / *** Delete File sections. All-or-nothing.",
        {
            "type": "object",
            "properties": {
                "patch": {"type": "string", "description": "patch text in the *** Begin Patch format"}
            },
            "required": ["patch"]
        },
        fn(args) {
            p := args["patch"]
            if (p == null || type(p) != "STRING" || p == "") {
                return "Error: patch required"
            }
            if (sandbox_mode() == "read-only") {
                return "Error: sandbox \"read-only\" blocks writes"
            }
            r := apply_patch.apply_text(p, cwd)
            if (r["ok"] != true) {
                return string(r["output"])
            }
            return string(r["output"])
        }
    )

    update_plan := tools.make_tool(
        "update_plan",
        "Update the plan checklist. Provide the FULL list of steps each time; each step is {\"step\": str, \"status\": \"pending\"|\"in_progress\"|\"completed\"}.",
        {
            "type": "object",
            "properties": {
                "steps": {
                    "type": "array",
                    "description": "full plan; each entry needs step (string) and status",
                    "items": {
                        "type": "object",
                        "properties": {
                            "step": {"type": "string"},
                            "status": {"type": "string", "description": "pending | in_progress | completed"}
                        },
                        "required": ["step", "status"]
                    }
                }
            },
            "required": ["steps"]
        },
        fn(args) {
            raw := args["steps"]
            if (type(raw) != "ARRAY") {
                return "Error: steps array required"
            }
            norm := []
            for (i := 0; i < len(raw); i += 1) {
                it := raw[i]
                if (type(it) != "HASH") { continue }
                text := it["step"]
                if (text == null) { text = it["text"] }
                if (text == null || type(text) != "STRING" || text == "") { continue }
                status := it["status"]
                if (status != "pending" && status != "in_progress" && status != "completed") {
                    status = "pending"
                }
                norm = arr.push(norm, {"step": text, "status": status})
            }
            plan_state["steps"] = norm
            done := 0
            for (i := 0; i < len(norm); i += 1) {
                st := norm[i]
                if (st["status"] == "completed") { done += 1 }
            }
            return "Plan updated (" + string(len(norm)) + " steps, " + string(done) + " completed)"
        }
    )

    return [read_file, write_file, edit, glob, grep, shell, apply_patch_tool, update_plan]
}

pub make_readonly_tools := fn(cwd) {
    all := make_coding_tools(cwd, {"allow_exec": false})
    by := tools.index_by_name(all)
    return [by["read_file"], by["glob"], by["grep"], by["update_plan"]]
}
