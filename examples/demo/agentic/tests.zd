// tests.zd — Zodex test aggregator (pure module checks + UI self-test).
//
// Run:
//   /tmp/opencode/zod_next examples/demo/agentic/tests.zd
//   ZODEX_HOME=/tmp/zodex_tests /tmp/opencode/zod_next examples/demo/agentic/tests.zd
//
// Session/history disk checks are skipped unless ZODEX_HOME is set, so a run
// never touches a real ~/.zodex. The mock-based client/agent suite lives in
// _check_agent.zd (needs the mock server on 127.0.0.1:8791).
//
// Exit code: 0 when every check passes, 1 otherwise.

import "harness_lib.zd" as hz
import "approvals.zd" as approvals
import "apply_patch.zd" as apply_patch
import "checkpoints.zd" as checkpoints
import "cli.zd" as cli
import "coding_tools.zd" as coding_tools
import "commands.zd" as commands
import "config.zd" as config
import "files.zd" as files
import "fx.zd" as fx
import "history.zd" as history
import "messages.zd" as messages
import "pi.zd" as pi
import "pricing.zd" as pricing
import "prompts.zd" as prompts
import "render.zd" as render
import "sandbox.zd" as sandbox
import "session.zd" as session
import "tools.zd" as tools
import "std/array" as arr
import "std/fs" as fs
import "std/json" as json
import "std/os" as os
import "std/str" as str
import "std/time" as time
import "std/fmt" as fmt

res := {"pass": 0, "fail": 0}

check := fn(name, cond) {
    if (cond == true) {
        res["pass"] = res["pass"] + 1
        fmt.println("PASS " + name)
    } else {
        res["fail"] = res["fail"] + 1
        fmt.println("FAIL " + name)
    }
    return null
}

// ---------------------------------------------------------------------------
// 1. harness UI self-test (typing, keys, picker, draw, mentions)
// ---------------------------------------------------------------------------

ui_res := hz.self_test_ui()
ui_lines := ui_res["lines"]
for (i := 0; i < len(ui_lines); i += 1) {
    fmt.println(ui_lines[i])
}
res["pass"] = res["pass"] + ui_res["pass"]
res["fail"] = res["fail"] + ui_res["fail"]

// ---------------------------------------------------------------------------
// 2. cli.parse (flags, exec prompt tail, order independence)
// ---------------------------------------------------------------------------

a1 := cli.parse(["t.zd", "exec", "hi"])
check("cli_exec_prompt", a1["mode"] == "exec" && a1["prompt"] == "hi")
a2 := cli.parse(["t.zd", "--cwd", "/x", "exec", "hello world"])
check("cli_cwd_before_exec", a2["cwd"] == "/x" && a2["mode"] == "exec" && a2["prompt"] == "hello world")
a3 := cli.parse(["t.zd", "--model", "m1", "--approvals", "never", "exec", "x"])
check("cli_model_approvals", a3["model"] == "m1" && a3["approvals"] == "never" && a3["prompt"] == "x")
a4 := cli.parse(["t.zd", "--json", "exec", "p"])
check("cli_json", a4["json"] == true && a4["mode"] == "exec")
a5 := cli.parse(["t.zd", "--resume", "latest"])
check("cli_resume", a5["resume"] == "latest")
a6 := cli.parse(["t.zd", "--self-test"])
check("cli_self_test", a6["mode"] == "self_test")
a7 := cli.parse(["t.zd", "--nope", "-q"])
check("cli_unknown", len(a7["unknown"]) == 2)
check("cli_help_v", cli.parse(["t.zd", "--help"])["help"] == true && cli.parse(["t.zd", "-v"])["version"] == true)
check("cli_version_string", str.contains(cli.version_string(), "zodex"))
check("cli_usage_mentions_exec", str.contains(cli.usage(), "exec"))
a8 := cli.parse(["t.zd", "--yolo", "exec", "x"])
check("cli_yolo", a8["yolo"] == true && a8["mode"] == "exec" && a8["prompt"] == "x")
check("cli_yolo_alias", cli.parse(["t.zd", "--dangerously-bypass-approvals-and-sandbox"])["yolo"] == true)
check("cli_usage_mentions_yolo", str.contains(cli.usage(), "--yolo"))

// ---------------------------------------------------------------------------
// 3. config defaults + merge
// ---------------------------------------------------------------------------

cfg := config.defaults()
check("config_defaults", cfg["model"] != null && cfg["base_url"] != null && cfg["approvals"] != null)
merged := config.merge(cfg, {"model": "zzz"})
check("config_merge_override", merged["model"] == "zzz" && merged["base_url"] == cfg["base_url"])

// ---------------------------------------------------------------------------
// 3b. profiles, -c overrides, --full-auto
// ---------------------------------------------------------------------------

b1 := cli.parse(["t.zd", "--profile", "work", "-c", "model=x", "-c", "max_steps=5", "--full-auto", "exec", "hi"])
check("cli_profile_parses", b1["profile"] == "work" && len(b1["overrides"]) == 2 && b1["overrides"][0] == "model=x" && b1["full_auto"] == true && b1["mode"] == "exec")
check("cli_usage_new_flags", str.contains(cli.usage(), "--profile") && str.contains(cli.usage(), "--full-auto") && str.contains(cli.usage(), "-c key=value"))
pcfg := config.defaults()
pcfg["profiles"] = {"work": {"model": "wm"}}
pr1 := config.profile_overlay(pcfg, "work")
check("cfg_profile_applies", pr1["ok"] == true && pr1["cfg"]["model"] == "wm")
pr2 := config.profile_overlay(pcfg, "nope")
check("cfg_profile_unknown", pr2["ok"] == false && str.contains(pr2["error"], "nope"))
pr3 := config.profile_overlay(config.defaults(), null)
check("cfg_profile_none", pr3["ok"] == true && pr3["cfg"]["model"] == cfg["model"])
od := config.apply_overrides(config.defaults(), ["model=m1", "max_steps=7", "temperature=0.2", "stream_usage=false"])
oc := od["cfg"]
check("cfg_override_types", len(od["errors"]) == 0 && oc["model"] == "m1" && oc["max_steps"] == 7 && type(oc["temperature"]) == "FLOAT" && oc["stream_usage"] == false)
oe := config.apply_overrides(config.defaults(), ["model", "max_steps=nope"])
check("cfg_override_errors", len(oe["errors"]) == 2)
dcfg := config.defaults()
check("cfg_defaults_new_keys", dcfg["bell"] == true && dcfg["sandbox_tool"] == "auto" && type(dcfg["sandbox_binds"]) == "ARRAY")

// ---------------------------------------------------------------------------
// 3c. sandbox wrapper argv builder (pure)
// ---------------------------------------------------------------------------

has_pair := fn(a, x, y) {
    for (i := 0; i + 1 < len(a); i += 1) {
        if (a[i] == x && a[i + 1] == y) { return true }
    }
    return false
}
w1 := sandbox.wrap_argv("read-only", "/proj", null, [], "echo hi")
check("sandbox_wrap_readonly", has_pair(w1, "--ro-bind", "/") == true && arr.contains(w1, "--bind") == false && has_pair(w1, "--chdir", "/proj") && w1[len(w1) - 3] == "sh" && w1[len(w1) - 2] == "-c" && w1[len(w1) - 1] == "echo hi")
w2 := sandbox.wrap_argv("workspace-write", "/proj", "/proj/sub", ["/cache"], "ls")
check("sandbox_wrap_workspace", has_pair(w2, "--bind", "/proj") && has_pair(w2, "--bind", "/proj/sub") && has_pair(w2, "--bind", "/cache") && has_pair(w2, "--chdir", "/proj/sub"))
w3 := sandbox.wrap_argv("workspace-write", "/proj", "/proj", ["/proj"], "ls")
nbind := 0
for (i := 0; i < len(w3); i += 1) {
    if (w3[i] == "--bind") { nbind += 1 }
}
check("sandbox_wrap_no_bind_dedup", nbind == 1)
check("sandbox_describe", sandbox.describe("bwrap") == "bwrap" && sandbox.describe(null) == "advisory")
check("sandbox_probe_off", sandbox.probe({"sandbox_tool": "off"}) == null)
check("sandbox_probe_missing", sandbox.probe({"sandbox_tool": "definitely-not-a-real-tool-xyz"}) == null)

// ---------------------------------------------------------------------------
// 3d. checkpoints + undo
// ---------------------------------------------------------------------------

pp := checkpoints.patch_paths("*** Begin Patch\n*** Update File: aa.txt\n@@\n-x\n+y\n*** Add File: sub/bb.txt\n*** Move to: cc.txt\n*** End Patch\nnot a marker line")
check("ck_patch_paths", len(pp) == 3 && pp[0] == "aa.txt" && pp[1] == "sub/bb.txt" && pp[2] == "cc.txt")
ckbase := "/tmp/zodex_tests/ck"
ckdir := "/tmp/zodex_tests/ckproj"
ignored_c1 := try(fs.rm(ckbase))
ignored_c2 := try(fs.mkdir(ckdir))
ignored_c3 := try(fs.mkdir(ckbase))
ignored_c4 := try(fs.write_file(ckdir + "/a.txt", "one"))
n1 := checkpoints.capture("tsess", 1, ckdir, ["a.txt", "new.txt"], ckbase)
check("ck_capture_count", n1 == 2)
lt := checkpoints.list_turns("tsess", ckbase)
check("ck_list_turns", type(lt) == "ARRAY" && len(lt) == 1)
ignored_c5 := try(fs.write_file(ckdir + "/a.txt", "two"))
ignored_c6 := try(fs.write_file(ckdir + "/new.txt", "created"))
rep := checkpoints.undo_last("tsess", ckbase)
check("ck_undo_report", str.contains(rep, "restored 1") && str.contains(rep, "deleted 1"))
ar := try(fs.read_file(ckdir + "/a.txt"))
check("ck_undo_restored", ar[0] && string(ar[1]) == "one")
nx := try(fs.exists(ckdir + "/new.txt"))
check("ck_undo_deleted_new", nx[0] && nx[1] != true)
rep2 := checkpoints.undo_last("tsess", ckbase)
check("ck_nothing_twice", str.contains(rep2, "nothing to undo"))
ckp2 := "/tmp/zodex_tests/ckproj2"
ignored_c7 := try(fs.rm(ckp2))
ignored_c8 := try(fs.mkdir(ckp2))
ignored_c9 := try(fs.write_file(ckp2 + "/f.txt", "v1"))
n2 := checkpoints.capture("tsess2", 1, ckp2, ["f.txt"], ckbase)
ignored_c10 := try(fs.write_file(ckp2 + "/f.txt", "v2"))
n3 := checkpoints.capture("tsess2", 2, ckp2, ["f.txt"], ckbase)
ignored_c11 := try(fs.write_file(ckp2 + "/f.txt", "v3"))
rep3 := checkpoints.undo_last("tsess2", ckbase)
fr3 := try(fs.read_file(ckp2 + "/f.txt"))
check("ck_undo_newest_turn", n2 == 1 && n3 == 1 && str.contains(rep3, "002") && fr3[0] && string(fr3[1]) == "v2")
rep4 := checkpoints.undo_last("tsess2", ckbase)
fr4 := try(fs.read_file(ckp2 + "/f.txt"))
check("ck_undo_next_turn", str.contains(rep4, "001") && fr4[0] && string(fr4[1]) == "v1")
rep5 := checkpoints.undo_last("tsess2", ckbase)
check("ck_undo_none", str.contains(rep5, "nothing to undo"))

// ---------------------------------------------------------------------------
// 3e. files + pickers
// ---------------------------------------------------------------------------
fw := "/tmp/zodex_tests/fwalk"
ignored_f1 := try(fs.rm(fw))
ignored_f2 := try(fs.mkdir(fw + "/sub"))
ignored_f3 := try(fs.mkdir(fw + "/node_modules"))
ignored_f4 := try(fs.mkdir(fw + "/.hidden"))
ignored_f5 := try(fs.write_file(fw + "/a.txt", "a"))
ignored_f6 := try(fs.write_file(fw + "/sub/b.txt", "b"))
ignored_f7 := try(fs.write_file(fw + "/node_modules/x.js", "x"))
ignored_f8 := try(fs.write_file(fw + "/.hidden/c.txt", "c"))
wl := files.walk(fw, 100)
check("files_walk_skip", arr.contains(wl, "a.txt") && arr.contains(wl, "sub/b.txt") && !arr.contains(wl, "node_modules/x.js") && !arr.contains(wl, ".hidden/c.txt") && len(wl) == 2)
check("files_fuzzy", files.fuzzy_score("src/app.zd", "app") >= 0 && files.fuzzy_score("SRC/App.zd", "app") >= 0 && files.fuzzy_score("src/app.zd", "zzz") == -1)
rk := files.rank(["src/lib/util.zd", "src/app.zd", "README.md"], "app", 10)
check("files_rank_order", len(rk) >= 1 && rk[0] == "src/app.zd")
rk2 := files.rank(["one.txt", "two.txt", "three.txt"], "", 2)
check("files_rank_head", len(rk2) == 2 && rk2[0] == "one.txt" && rk2[1] == "two.txt")
fpapp := {"tty": true, "ui": hz.new_ui(fw, "m"), "cwd": fw, "file_cache": {"cwd": "", "paths": []}}
ignored_f9 := hz.open_file_picker(fpapp)
fpu := fpapp["ui"]
fpk := fpu["picker"]
check("fp_open", fpk != null && fpk["kind"] == "file" && type(fpk["items"]) == "ARRAY" && len(fpk["items"]) == 2)
hz.handle_key(fpu, {"app": fpapp}, "b")
fpk2 := fpu["picker"]
check("fp_filter", fpk2["query"] == "b" && len(fpk2["items"]) == 1 && fpk2["items"][0] == "sub/b.txt")
hz.handle_key(fpu, {"app": fpapp}, "\r")
check("fp_insert", fpu["picker"] == null && str.contains(fpu["input"], "@sub/b.txt"))
spbox := {"got": ""}
spapp := {"tty": true, "ui": hz.new_ui("/tmp", "m")}
spu := spapp["ui"]
spu["picker"] = {"kind": "session", "title": "session", "items": ["abc12345  hello"], "ids": ["abc12345"], "sel": 0}
sctx := {"app": spapp, "on_resume": fn(id) { spbox["got"] = string(id); return "resumed " + string(id) }}
hz.handle_key(spu, sctx, "\r")
check("sp_enter", spu["picker"] == null && spbox["got"] == "abc12345")
reg5 := commands.make_registry(commands.all_commands())
ctx_line := {"app": {"tty": false}, "on_resume": fn(a) { return "resumed " + string(a) }, "on_picker": null}
d_line := commands.dispatch(reg5, ctx_line, "/resume")
check("resume_line_latest", d_line[0] == true && str.contains(string(d_line[1]), "resumed latest"))
ctx_tui := {"app": {"tty": true}, "on_resume": null, "on_picker": fn(k) { return "picker:" + string(k) }}
d_tui := commands.dispatch(reg5, ctx_tui, "/resume")
check("resume_tui_picker", d_tui[0] == true && string(d_tui[1]) == "picker:session")

// ---------------------------------------------------------------------------
// 3f. prompts + pricing
// ---------------------------------------------------------------------------
check("prompts_expand_args", prompts.expand("Do $ARGUMENTS now", "X") == "Do X now")
check("prompts_expand_append", prompts.expand("Do it", "extra") == "Do it\n\nextra" && prompts.expand("Do it", "") == "Do it")
pm6 := {"foo": "Run $ARGUMENTS"}
bl6 := ["/help", "/model"]
pr6 := prompts.resolve(pm6, bl6, "/foo bar")
check("prompts_resolve_ok", pr6 != null && pr6["name"] == "foo" && pr6["text"] == "Run bar")
check("prompts_resolve_builtin_wins", prompts.resolve(pm6, bl6, "/model x") == null)
check("prompts_resolve_unknown", prompts.resolve(pm6, bl6, "/nope") == null && prompts.resolve(pm6, bl6, "plain") == null)
proot := "/tmp/zodex_tests/prompts_root"
ignored_p1 := try(fs.rm(proot))
ignored_p2 := try(fs.mkdir(proot + "/prompts"))
ignored_p3 := try(fs.mkdir(proot + "/.zodex/prompts"))
ignored_p4 := try(fs.write_file(proot + "/prompts/a.md", "root a $ARGUMENTS"))
ignored_p5 := try(fs.write_file(proot + "/prompts/b.md", "root b"))
ignored_p6 := try(fs.write_file(proot + "/.zodex/prompts/a.md", "local a $ARGUMENTS"))
pl6 := prompts.load(proot, proot)
check("prompts_load_override", str.contains(string(pl6["a"]), "local a") && str.contains(string(pl6["b"]), "root b"))
check("pricing_lookup_longest", pricing.lookup("openai/gpt-4o-mini") != null && pricing.lookup("openai/gpt-4o-mini")["match"] == "gpt-4o-mini" && pricing.lookup("unknown-xyz") == null)
pe6 := pricing.estimate("gpt-4o-mini", 1000000, 1000000)
check("pricing_estimate", pe6 != null && pe6 > 0.7 && pe6 < 0.8)
check("pricing_fmt", pricing.fmt_cost(0.75) == "$0.7500" && pricing.fmt_cost(null) == "n/a" && pricing.fmt_cost(0.0) == "$0.0000")

// ---------------------------------------------------------------------------
// 3g. validation + help shadowing (adversarial fixes)
// ---------------------------------------------------------------------------
ovd7 := config.apply_overrides({"sandbox": "workspace-write"}, ["sandbox=readonly"])
check("overrides_badsandbox", len(ovd7["errors"]) == 1 && ovd7["cfg"]["sandbox"] == "workspace-write")
ovd8 := config.apply_overrides({}, ["approvals=neverr"])
check("overrides_badapprovals", len(ovd8["errors"]) == 1)
po7 := config.profile_overlay({"profiles": {"p": {"model": 5, "max_steps": 7}}}, "p")
check("profile_filters_badtypes", po7["ok"] == true && po7["cfg"]["model"] != 5 && po7["cfg"]["max_steps"] == 7)
po8 := config.profile_overlay({"profiles": {"p": 5}}, "p")
check("profile_nonhash", po8["ok"] == false && str.contains(string(po8["error"]), "must be a table"))
check("approvals_valid_mode", approvals.valid_mode("never") == true && approvals.valid_mode("nope") == false)
reg7 := commands.make_registry(commands.all_commands())
ctx7 := {"reg": reg7, "prompts": {"model": "x", "foo": "bar"}}
d7 := commands.dispatch(reg7, ctx7, "/help")
h7 := string(d7[1])
check("help_prompts_filtered", str.contains(h7, "/foo - prompt from .md file") && !str.contains(h7, "/model - prompt from .md file"))

// ---------------------------------------------------------------------------
// 4. approvals: decide + wrap
// ---------------------------------------------------------------------------

pol_u := approvals.new_policy("untrusted", null)
d1 := approvals.decide(pol_u, "read_file", "{}")
check("approvals_readonly_allow", d1["action"] == "allow")
d2 := approvals.decide(pol_u, "write_file", "{}")
check("approvals_untrusted_ask", d2["action"] == "ask")
d3 := approvals.decide(approvals.new_policy("never", null), "shell", "{}")
check("approvals_never_allow", d3["action"] == "allow")
d4 := approvals.decide(approvals.new_policy("on-failure", null), "shell", "{}")
check("approvals_onfailure_allow", d4["action"] == "allow")
d5 := approvals.decide(approvals.new_policy("untrusted", ["write_file"]), "write_file", "{}")
check("approvals_rule_allow", d5["action"] == "allow")
check("approvals_describe", str.contains(approvals.describe(pol_u), "untrusted"))
check("approvals_readonly_names", arr.contains(approvals.read_only_names(), "read_file"))

// ---------------------------------------------------------------------------
// 5. sandbox guard + tool wrappers (real tools against a temp dir)
// ---------------------------------------------------------------------------

TMP := "/tmp/opencode/_zodex_tests_" + string(time.now_ms())
mk := try(fs.mkdir(TMP))
w1 := try(fs.write_file(TMP + "/hello.txt", "hello-approvals"))

check("sandbox_valid", coding_tools.valid_sandbox("workspace-write") == true && coding_tools.valid_sandbox("nope") == false)
check("sandbox_default_fallback", coding_tools.make_guard("nope")["sandbox"] == "workspace-write")

guard := coding_tools.make_guard("workspace-write")
plan_state := coding_tools.make_plan_state()
base := coding_tools.make_coding_tools(TMP, {"guard": guard, "plan_state": plan_state})
by := tools.index_by_name(base)

rd1 := tools.call_tool(by, "read_file", json.stringify({"path": "hello.txt"}))
check("tool_read_file", str.contains(rd1, "hello-approvals"))

sh1 := tools.call_tool(by, "shell", json.stringify({"command": "echo zodex-test"}))
check("tool_shell_echo", str.contains(sh1, "zodex-test"))

rpl := tools.call_tool(by, "update_plan", json.stringify({"steps": [{"step": "a", "status": "pending"}, {"step": "b", "status": "pending"}]}))
check("tool_update_plan", !str.starts_with(rpl, "Error"))
check("plan_state_shared", len(plan_state["steps"]) == 2)

apt := tools.call_tool(by, "apply_patch", json.stringify({"patch": "*** Begin Patch\n*** Add File: patched.txt\n+patched-line\n*** End Patch\n"}))
check("tool_apply_patch", !str.starts_with(apt, "Error"))
rf := try(fs.read_file(TMP + "/patched.txt"))
check("tool_apply_patch_wrote", rf[0] && str.contains(string(rf[1]), "patched-line"))

wrap_pol := approvals.new_policy("untrusted", null)
deny_ask := fn(req) { return "deny" }
wrapped_d := approvals.wrap(base, wrap_pol, deny_ask)
by_d := tools.index_by_name(wrapped_d)
rw := tools.call_tool(by_d, "write_file", json.stringify({"path": "new1.txt", "content": "x"}))
check("wrap_deny_write", str.starts_with(rw, "Error") && str.contains(rw, "denied"))
rr := tools.call_tool(by_d, "read_file", json.stringify({"path": "hello.txt"}))
check("wrap_readonly_pass", str.contains(rr, "hello-approvals"))

allow_ask := fn(req) { return "allow" }
wrapped_a := approvals.wrap(base, approvals.new_policy("untrusted", null), allow_ask)
by_a := tools.index_by_name(wrapped_a)
ra := tools.call_tool(by_a, "write_file", json.stringify({"path": "new1.txt", "content": "made-it"}))
check("wrap_allow_write", !str.starts_with(ra, "Error"))
ra2 := tools.call_tool(by_a, "read_file", json.stringify({"path": "new1.txt"}))
check("wrap_wrote_file", str.contains(ra2, "made-it"))

base_ro := coding_tools.make_coding_tools(TMP, {"guard": coding_tools.make_guard("read-only"), "plan_state": coding_tools.make_plan_state()})
by_ro := tools.index_by_name(base_ro)
rro := tools.call_tool(by_ro, "write_file", json.stringify({"path": "nope.txt", "content": "x"}))
check("sandbox_readonly_blocks", str.starts_with(rro, "Error"))
rro2 := tools.call_tool(by_ro, "read_file", json.stringify({"path": "hello.txt"}))
check("sandbox_readonly_reads", str.contains(rro2, "hello-approvals"))

// ---------------------------------------------------------------------------
// 6. apply_patch module
// ---------------------------------------------------------------------------

pp := apply_patch.parse_patch("*** Begin Patch\n*** Delete File: patched.txt\n*** End Patch\n")
check("parse_patch_ok", pp["ok"] == true)
bad := apply_patch.parse_patch("not a patch")
check("parse_patch_bad", bad["ok"] == false)
del := apply_patch.apply_text("*** Begin Patch\n*** Delete File: patched.txt\n*** End Patch\n", TMP)
check("apply_text_delete", del["ok"] == true)
ex := try(fs.exists(TMP + "/patched.txt"))
check("apply_text_deleted_file", ex[0] && ex[1] != true)

// ---------------------------------------------------------------------------
// 7. session (lazy meta; disk checks gated on ZODEX_HOME)
// ---------------------------------------------------------------------------

sess1 := session.new_session(TMP, {"model": "test-model"})
check("session_id_path", type(sess1["id"]) == "STRING" && str.ends_with(string(sess1["path"]), ".jsonl"))
lazy := try(fs.exists(sess1["path"]))
check("session_lazy_no_file", lazy[0] && lazy[1] != true)

if (os.env_get("ZODEX_HOME") != null) {
    rm1 := session.record_message(sess1, {"role": "user", "content": "hello session"})
    ex2 := try(fs.exists(sess1["path"]))
    check("session_written", ex2[0] && ex2[1] == true)
    lm := session.load(sess1["path"])
    check("session_load_ok", lm["ok"] == true && len(lm["messages"]) == 1)
    check("session_meta", lm["meta"]["cwd"] == TMP && lm["meta"]["model"] == "test-model")
    rows := session.list()
    found := false
    for (i := 0; i < len(rows); i += 1) {
        if (string(rows[i]["id"]) == string(sess1["id"])) { found = true }
    }
    check("session_listed", found)
    delf := try(fs.rm(sess1["path"]))
} else {
    fmt.println("SKIP session disk checks (set ZODEX_HOME=/tmp/zodex_tests to enable)")
}

// ---------------------------------------------------------------------------
// 8. history
// ---------------------------------------------------------------------------

hist := history.load()
check("history_load_array", type(hist) == "ARRAY")
h1 := history.add(hist, "dup-line-xyz")
h2 := history.add(h1, "dup-line-xyz")
check("history_dedup", len(h2) == len(h1))
h3 := history.add(h2, "other-line-xyz")
check("history_add", len(h3) == len(h2) + 1)
check("history_path", type(history.path()) == "STRING")

// ---------------------------------------------------------------------------
// 9. pi context loading
// ---------------------------------------------------------------------------

ctxdir := TMP + "/ctxproj"
mk2 := try(fs.mkdir(ctxdir))
cw := try(fs.write_file(ctxdir + "/AGENTS.md", "CTX-MARKER-123"))
cf := pi.load_context(ctxdir)
check("pi_load_context", str.contains(string(cf["system_extra"]), "CTX-MARKER-123"))
check("pi_context_sources", len(cf["sources"]) >= 1)
bsys := pi.build_system("BASE-SYS", cf["system_extra"])
check("pi_build_system", str.contains(bsys, "BASE-SYS") && str.contains(bsys, "CTX-MARKER-123"))

// ---------------------------------------------------------------------------
// 10. messages
// ---------------------------------------------------------------------------

conv := messages.new_conversation("SYS")
cms := conv["messages"]
c0 := cms[0]
check("msg_conversation_system", c0["role"] == "system")
conv2 := messages.new_conversation("s2")
addf := conv2["add"]
lastf := conv2["last"]
ignored_a := addf(conv2, "user", "hi", null)
lastm := lastf(conv2)
check("msg_add_last", lastm["content"] == "hi")

// ---------------------------------------------------------------------------
// 11. render / fx / tools smoke
// ---------------------------------------------------------------------------

check("render_display_width", render.display_width("hello") == 5)
check("render_display_width_ansi", render.display_width("\x1b[31mhi\x1b[0m") == 2)
check("render_pad_width", render.display_width(render.pad("ab", 5)) == 5)
check("render_truncate_width", render.display_width(render.truncate("abcdefghij", 5, "…")) <= 5)
bl := render.welcome_lines(40, "m1", "/tmp/d", "v0.1.0")
check("render_welcome", type(bl) == "ARRAY" && len(bl) > 0)
dl := render.diff("+add\n-remove", 20)
check("render_diff_colors", len(dl) == 2)
tcell := {"kind": "tool", "name": "shell", "label": "Ran echo hi", "result": "exit 0\nhi", "status": "ok"}
tl := render.cell_lines(tcell, 40, render.theme())
check("render_tool_cell", len(tl) == 3 && str.contains(tl[0], "Ran echo hi") && str.contains(tl[1], "└"))
check("fx_working_row", str.contains(fx.working_row(1), "Working") && str.contains(fx.working_row(1), "esc to interrupt"))
check("fx_interrupt_marker", len(fx.interrupt_marker()) > 0)

t1 := tools.make_tool("t1", "d", {"type": "object"}, fn(args) { return "ok" })
by2 := tools.index_by_name([t1])
check("tools_index_by_name", by2["t1"] != null)
r_bad := tools.call_tool(by2, "nope", "{}")
check("tools_unknown_error", str.starts_with(r_bad, "Error"))
oai := tools.to_openai([t1])
o0 := oai[0]
check("tools_to_openai", o0["type"] == "function" && o0["function"]["name"] == "t1")

// ---------------------------------------------------------------------------
// summary
// ---------------------------------------------------------------------------

fmt.println("SUMMARY pass=" + string(res["pass"]) + " fail=" + string(res["fail"]))
if (res["fail"] > 0) { os.exit(1) }
os.exit(0)
