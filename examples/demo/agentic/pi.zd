import "tools.zd" as tools
import "coding_tools.zd" as coding_tools
import "std/os" as os
import "std/fs" as fs
import "std/str" as str
import "std/array" as arr
import "std/hash" as hash
import "std/json" as json

// pi.zd — MINIMAL Pi-style core (see pi.dev philosophy).
// 4 default tools, context files, tree sessions, print mode, model switching.
// Everything else stays in the existing modules (agent, commands, harness).
// Pure Zod: std/* + coding_tools + tools only. No network. No top-level execution.

// Read one context file; null when missing/unreadable. Caps at 8000 chars.
read_capped := fn(path) {
    r := try(fs.read_file(path))
    if (!r[0]) {
        return null
    }
    content := r[1]
    if (type(content) != "STRING") {
        return null
    }
    if (len(content) > 8000) {
        n := len(content) - 8000
        content = str.slice(content, 0, 8000) + "\n...[truncated " + string(n) + " chars]"
    }
    return content
}

// 1. Minimal default toolset: exactly [read_file, write_file, edit, bash],
// picked by NAME (never by position — upstream order may change).
pub default_tools := fn(cwd, opts) {
    all := coding_tools.make_coding_tools(cwd, opts)
    by := tools.index_by_name(all)
    return [by["read_file"], by["write_file"], by["edit"], by["bash"]]
}

// Full coding toolset (power users / subagents). Passes opts through.
pub power_pack := fn(cwd, opts) {
    return coding_tools.make_coding_tools(cwd, opts)
}

// 2. Load context files for the agent system prompt. Missing = skip.
// Returns {"system_extra": STRING, "sources": ARRAY of loaded paths}.
pub load_context := fn(cwd) {
    extra := ""
    sources := []
    p1 := cwd + "/AGENTS.md"
    c1 := read_capped(p1)
    if (c1 != null) {
        extra = extra + "\n\n# " + p1 + "\n" + c1
        sources = arr.push(sources, p1)
    }
    p2 := cwd + "/SYSTEM.md"
    c2 := read_capped(p2)
    if (c2 != null) {
        extra = extra + "\n\n# " + p2 + "\n" + c2
        sources = arr.push(sources, p2)
    }
    home := os.env_get("HOME")
    if (home != null && type(home) == "STRING" && home != "") {
        p3 := home + "/.pi/agent/AGENTS.md"
        c3 := read_capped(p3)
        if (c3 != null) {
            extra = extra + "\n\n# " + p3 + "\n" + c3
            sources = arr.push(sources, p3)
        }
    }
    return {"system_extra": extra, "sources": sources}
}

// 3. Combine base system prompt with loaded context (extra "" -> base).
pub build_system := fn(base, extra) {
    if (extra == null || extra == "") {
        return base
    }
    return base + "\n\n" + extra
}

// 4. CLI arg parsing (pure, no network).
// null -> interactive. First "-p" -> print mode, prompt = all following
// elements joined with " ". Any element == "json" -> format json (+print).
// Returns {"mode": "print"|"interactive", "prompt": STRING, "format": ...}.
pub parse_args := fn(args) {
    mode := "interactive"
    prompt := ""
    format := "text"
    if (args == null || type(args) != "ARRAY") {
        return {"mode": mode, "prompt": prompt, "format": format}
    }
    total := len(args)
    found := -1
    for (i := 0; i < total; i += 1) {
        if (args[i] == "-p") {
            found = i
            break
        }
    }
    if (found >= 0) {
        mode = "print"
        tail := arr.slice(args, found + 1, total)
        prompt = str.join(tail, " ")
    }
    has_json := false
    for (j := 0; j < total; j += 1) {
        if (args[j] == "json") {
            has_json = true
            break
        }
    }
    if (has_json) {
        format = "json"
        mode = "print"
    }
    return {"mode": mode, "prompt": prompt, "format": format}
}

// 5. Tree sessions: named conversation snapshots over a conv hash
// (messages.zd shape: conv["messages"], conv["to_api"](conv)).

// Fresh tree with one empty branch.
pub new_tree := fn() {
    return {"branches": {"main": []}, "current": "main"}
}

// Snapshot conv into the current branch. Returns status string.
pub tree_save := fn(tree, conv) {
    snap := conv["to_api"](conv)
    cur := tree["current"]
    br := tree["branches"]
    br[cur] = snap
    return "saved " + string(len(snap)) + " msgs on " + cur
}

// One "branch *name (N msgs)" line per branch ("*" marks current).
pub tree_list := fn(tree) {
    br := tree["branches"]
    cur := tree["current"]
    names := hash.keys(br)
    if (len(names) == 0) {
        return "(empty)"
    }
    lines := []
    for (i := 0; i < len(names); i += 1) {
        nm := names[i]
        msgs := br[nm]
        n := 0
        if (type(msgs) == "ARRAY") {
            n = len(msgs)
        }
        mark := ""
        if (nm == cur) {
            mark = "*"
        }
        lines = arr.push(lines, "branch " + mark + nm + " (" + string(n) + " msgs)")
    }
    return str.join(lines, "\n")
}

// Restore branch snapshot into conv and switch current. Never error().
pub tree_checkout := fn(tree, name, conv) {
    br := tree["branches"]
    if (name == null || type(name) != "STRING" || !hash.contains(br, name)) {
        return "Error: no branch " + string(name)
    }
    msgs := br[name]
    conv["messages"] = msgs
    tree["current"] = name
    n := 0
    if (type(msgs) == "ARRAY") {
        n = len(msgs)
    }
    return "on " + name + " (" + string(n) + " msgs)"
}

// Copy current snapshot to a new branch name and switch. Never error().
pub tree_branch := fn(tree, name, conv) {
    if (name == null || type(name) != "STRING" || name == "") {
        return "Error: branch name required"
    }
    snap := conv["to_api"](conv)
    br := tree["branches"]
    br[name] = snap
    tree["current"] = name
    return "branched " + name + " (" + string(len(snap)) + " msgs)"
}

// 6. Persisted tree sessions (cwd/.zodpi/session.json). Never halts.

pub session_path := fn(cwd) {
    return cwd + "/.zodpi/session.json"
}

// Save {"branches","current"} as JSON. Returns true/false, never halts.
pub session_save := fn(tree, cwd) {
    ignored := try(fs.mkdir(cwd + "/.zodpi"))
    payload := {"branches": tree["branches"], "current": tree["current"]}
    wr := try(fs.write_file(session_path(cwd), json.stringify(payload)))
    if (!wr[0]) {
        return false
    }
    return true
}

// Load a saved tree; fresh tree when missing/corrupt/invalid. Never halts.
pub session_load := fn(cwd) {
    r := try(fs.read_file(session_path(cwd)))
    if (!r[0]) {
        return new_tree()
    }
    p := try(json.parse(r[1]))
    if (!p[0]) {
        return new_tree()
    }
    h := p[1]
    if (type(h) != "HASH") {
        return new_tree()
    }
    if (h["branches"] == null || h["current"] == null) {
        return new_tree()
    }
    if (type(h["branches"]) != "HASH" || type(h["current"]) != "STRING") {
        return new_tree()
    }
    return h
}
