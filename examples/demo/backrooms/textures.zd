// textures.zd — procedural 64x64 material atlases.
//
// Every texel stores a palette index and, separately, an ASCII glyph id.
// The half-block renderer only reads the colour atlas; ASCII mode reads
// both. The floor and ceiling atlases repeat every eight world cells;
// the wall atlas maps u across a wall cell and v from top to bottom.
//
// Textures are deterministic, so the same world seed always produces
// the same carpet stains, wallpaper seams, and fluorescent panels.

import "std/math" as math

pub TEX_N := 64
pub TEX_SCALE := 8.0
pub TEX_OFFSET := 10000000.0

let TEX_MASK = 63

// hash2 is a small deterministic integer hash used only while building
// the atlases. It is not called from the render loop.
let hash2 = fn(x, y) {
  let h = (x * 374761393 + y * 668265263 + 1013904223) % 2147483647
  h = (h * 1274126177) % 2147483647
  if (h < 0) {
    h = -h
  }
  return h
}

// fade and lerp drive the tileable value noise below.
let fade = fn(t) {
  return t * t * (3.0 - 2.0 * t)
}

let lerp = fn(a, b, t) {
  return a + (b - a) * t
}

// vnoise samples a tileable 0..1 value-noise field. cell must divide
// TEX_N; the lattice wraps so the 64x64 atlas still tiles seamlessly.
let vnoise = fn(x, y, cell) {
  let period = TEX_N / cell
  let gx = x / cell
  let gy = y / cell
  let fx = float(x % cell) / float(cell)
  let fy = float(y % cell) / float(cell)
  let sx = fade(fx)
  let sy = fade(fy)
  let x0 = gx % period
  let y0 = gy % period
  let x1 = (gx + 1) % period
  let y1 = (gy + 1) % period
  let a = float(hash2(x0 + 11, y0 + 23) % 1000) / 1000.0
  let b = float(hash2(x1 + 11, y0 + 23) % 1000) / 1000.0
  let c = float(hash2(x0 + 11, y1 + 23) % 1000) / 1000.0
  let d = float(hash2(x1 + 11, y1 + 23) % 1000) / 1000.0
  return lerp(lerp(a, b, sx), lerp(c, d, sx), sy)
}

// soft is a smoothstep mask for v in [lo, hi].
let soft = fn(v, lo, hi) {
  let t = (v - lo) / (hi - lo)
  if (t < 0.0) {
    t = 0.0
  }
  if (t > 1.0) {
    t = 1.0
  }
  return t * t * (3.0 - 2.0 * t)
}

// grain_offset maps 0..1 noise to a rounded -amp..+amp shade offset.
let grain_offset = fn(v, amp) {
  return math.round((v - 0.5) * 2.0 * float(amp))
}

// build_floor: damp office carpet. Soft pile grain, broad stains, darker
// seams every two cells, and a subtle checker in the pile.
let build_floor = fn() {
  let color = make(TEX_N * TEX_N, 0)
  let glyph = make(TEX_N * TEX_N, 0)
  for (ty := 0; ty < TEX_N; ty++) {
    for (tx := 0; tx < TEX_N; tx++) {
      let idx = ty * TEX_N + tx
      let grain = vnoise(tx, ty, 4)
      let broad = vnoise(tx, ty, 8)
      let shade = 4
      shade = shade + grain_offset(grain, 1)
      shade = shade + int(soft(broad, 0.58, 0.95) * 3.0 + 0.5)
      shade = shade - int(soft(broad, 0.96, 1.0) + 0.5)
      if (tx % 16 == 0 || ty % 16 == 0) {
        shade = shade + 2
      }
      if ((tx / 8 + ty / 8) % 2 == 0) {
        shade = shade + 1
      }
      if (shade < 0) {
        shade = 0
      }
      if (shade > 15) {
        shade = 15
      }
      color[idx] = 16 + shade
      let g = 4
      if (shade >= 7) {
        g = 9
      }
      if (shade >= 10) {
        g = 8
      }
      if (shade >= 13) {
        g = 7
      }
      glyph[idx] = g
    }
  }
  return {"color": color, "glyph": glyph}
}

// build_ceiling: acoustic tiles with a 2x1 fluorescent panel every
// eight cells. The panel glow is baked into the tile shades so the
// renderer only pays for one atlas lookup per pixel.
let build_ceiling = fn() {
  let color = make(TEX_N * TEX_N, 0)
  let glyph = make(TEX_N * TEX_N, 0)
  for (ty := 0; ty < TEX_N; ty++) {
    for (tx := 0; tx < TEX_N; tx++) {
      let idx = ty * TEX_N + tx
      let grain = vnoise(tx, ty, 4)
      let shade = 4
      shade = shade + grain_offset(grain, 1)
      let fx = tx % 8
      let fz = ty % 8
      if (fx == 0 || fz == 0) {
        shade = shade + 3
      }

      // Distance to the nearest panel centre, wrapped across the tile.
      let dx = tx - 23
      if (dx < 0) {
        dx = -dx
      }
      if (dx > 32) {
        dx = 64 - dx
      }
      let dz = ty - 19
      if (dz < 0) {
        dz = -dz
      }
      if (dz > 32) {
        dz = 64 - dz
      }
      if (dx < 18 && dz < 14) {
        shade = shade - 1
      }
      if (dx < 11 && dz < 8) {
        shade = shade - 1
      }
      if (shade < 0) {
        shade = 0
      }
      if (shade > 15) {
        shade = 15
      }

      let c = shade
      let g = 5
      if (dx < 10 && dz < 7) {
        g = 9
      }

      if (tx >= 17 && tx <= 30 && ty >= 17 && ty <= 22) {
        c = 80 + int(vnoise(tx, ty, 4) * 2.999)
        g = 7
      } else if ((tx == 16 || tx == 31) && ty >= 16 && ty <= 23) {
        c = 68
        g = 2
      } else if ((ty == 16 || ty == 23) && tx >= 16 && tx <= 31) {
        c = 68
        g = 6
      }

      color[idx] = c
      glyph[idx] = g
    }
  }
  return {"color": color, "glyph": glyph}
}

// build_wall styles:
//   1 wallpaper (z-side base 32, x-side base 48)
//   2 concrete pillar
//   3 stained wallpaper
//   4 dark door-frame trim
let build_wall = fn(base, style) {
  let color = make(TEX_N * TEX_N, 0)
  let glyph = make(TEX_N * TEX_N, 0)
  for (ty := 0; ty < TEX_N; ty++) {
    for (tx := 0; tx < TEX_N; tx++) {
      let idx = ty * TEX_N + tx
      let grain = vnoise(tx, ty, 4)
      let broad = vnoise(tx, ty, 8)
      let shade = 5
      let g = 1

      if (style == 1) {
        let stripe = (tx / 4) % 2
        if (stripe == 0) {
          shade = 6
        } else {
          shade = 7
        }
        shade = shade + grain_offset(grain, 1)
        shade = shade + int(soft(broad, 0.94, 1.0) * 2.0 + 0.5)
        if (tx % 16 == 0) {
          shade = shade + 1
          g = 2
        }
        if (broad > 0.94) {
          g = 8
        }
        if (grain > 0.82) {
          g = 9
        }
      } else if (style == 2) {
        shade = 7
        shade = shade + grain_offset(grain, 1)
        if (ty % 16 == 0) {
          shade = shade + 3
          g = 2
        } else {
          g = 7
        }
        if (tx % 16 == 0) {
          shade = shade + 2
          g = 1
        }
        shade = shade + int(soft(broad, 0.80, 0.95) * 2.0 + 0.5)
        if (broad > 0.86) {
          g = 8
        }
      } else if (style == 3) {
        let stripe = (tx / 5) % 2
        if (stripe == 0) {
          shade = 7
        } else {
          shade = 9
        }
        shade = shade + grain_offset(grain, 1)
        shade = shade + int(soft(broad, 0.68, 0.88) * 2.0 + 0.5)
        if (tx % 20 == 0) {
          shade = shade + 2
        }
        g = 8
        if (broad > 0.86) {
          g = 7
        }
        if (grain > 0.84) {
          g = 9
        }
      } else {
        shade = 6
        if ((tx / 2) % 2 == 0) {
          shade = shade + 1
        }
        if (tx % 8 == 0) {
          shade = shade + 2
          g = 1
        } else {
          g = 17
        }
        shade = shade + int(soft(grain, 0.85, 0.98) * 2.0 + 0.5)
        if (grain > 0.9) {
          g = 7
        }
      }

      if (ty <= 1) {
        shade = shade + 3
        g = 15
      }

      if ((style == 1 || style == 3) && ty >= 38 && ty <= 41) {
        color[idx] = 68
        glyph[idx] = 6
      } else if (ty >= 56) {
        let bs = 3 + (ty - 56) / 3
        if (bs > 9) {
          bs = 9
        }
        color[idx] = 64 + bs
        glyph[idx] = 6
      } else {
        if (shade < 0) {
          shade = 0
        }
        if (shade > 15) {
          shade = 15
        }
        color[idx] = base + shade
        glyph[idx] = g
      }
    }
  }
  return {"color": color, "glyph": glyph}
}

pub build := fn() {
  let floor = build_floor()
  let ceil = build_ceiling()
  let w1z = build_wall(32, 1)
  let w1x = build_wall(48, 1)
  let w2 = build_wall(48, 2)
  let w3 = build_wall(48, 3)
  let w4 = build_wall(64, 4)
  return {
    "floor_color": floor["color"],
    "floor_glyph": floor["glyph"],
    "ceil_color": ceil["color"],
    "ceil_glyph": ceil["glyph"],
    "wall1z_color": w1z["color"],
    "wall1z_glyph": w1z["glyph"],
    "wall1x_color": w1x["color"],
    "wall1x_glyph": w1x["glyph"],
    "wall2_color": w2["color"],
    "wall2_glyph": w2["glyph"],
    "wall3_color": w3["color"],
    "wall3_glyph": w3["glyph"],
    "wall4_color": w4["color"],
    "wall4_glyph": w4["glyph"]
  }
}
