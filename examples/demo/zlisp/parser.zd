from "token.zd" import TOKEN

pub makeParser := fn(lexer) {
    curToken := null
    peekToken := null

    nextToken := fn() {
        curToken = peekToken
        peekToken = lexer["nextToken"]()
    }

    nextToken()
    nextToken()

    parseAtom := fn() {
        if (curToken["type"] == TOKEN["INT"]) {
            v := int(curToken["literal"])
            nextToken()
            return {"type": "Integer", "value": v}
        }
        if (curToken["type"] == TOKEN["FLOAT"]) {
            v := float(curToken["literal"])
            nextToken()
            return {"type": "Float", "value": v}
        }
        if (curToken["type"] == TOKEN["STRING"]) {
            v := curToken["literal"]
            nextToken()
            return {"type": "String", "value": v}
        }
        if (curToken["type"] == TOKEN["SYMBOL"]) {
            v := curToken["literal"]
            nextToken()
            if (v == "true") { return {"type": "Boolean", "value": true} }
            if (v == "false") { return {"type": "Boolean", "value": false} }
            if (v == "nil") { return {"type": "Nil"} }
            return {"type": "Symbol", "value": v}
        }

        {"type": "Error", "value": "Unexpected token in atom" + curToken["literal"]}
    }

    parseList := fn() {
        nextToken()
        elements := []
        
        loop {
            if (curToken["type"] == TOKEN["RPAREN"] || curToken["type"] == TOKEN["EOF"]) {
                break
            }
            elements = push(elements, parseExpression())
        }
        if (curToken["type"] != TOKEN["RPAREN"]) {
            return {"type": "Error", "value": "missing closing parenthesis"}
        }
        nextToken()
        return {"type": "List", "value": elements}
    }

    parseExpression := fn() {
        if (curToken["type"] == TOKEN["QUOTE"]) {
            nextToken()
            expr := parseExpression()
            return {"type": "List", "value": [{"type": "Symbol", "value": "quote"}, expr]}
        } else if (curToken["type"] == TOKEN["LPAREN"]) {
            return parseList()
        } else {
            return parseAtom()
        }
    }

    parseProgram := fn() {
        program := []
        loop {
            if (curToken["type"] == TOKEN["EOF"]) {
                break
            }
            program = push(program, parseExpression())
        }
        program
    }

    {
        "parseProgram": parseProgram
    }

} 
