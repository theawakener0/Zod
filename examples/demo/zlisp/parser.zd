from "token.zd" import TOKEN

pub makeParser := fn(lexer) {
    curToken := null
    peekToken := null

    // The VM rejects local forward references, so mutual recursion between
    // parseList and parseExpression goes through this indirection.
    exprRef := {"fn": null}

    nextToken := fn() {
        curToken = peekToken
        peekToken = lexer["nextToken"]()
    }

    nextToken()
    nextToken()

    parseAtom := fn() {
        if (curToken["type"] == TOKEN["INT"]) {
            v := int(curToken["literal"])
            nextToken()
            return {"type": "Integer", "value": v}
        }
        if (curToken["type"] == TOKEN["FLOAT"]) {
            v := float(curToken["literal"])
            nextToken()
            return {"type": "Float", "value": v}
        }
        if (curToken["type"] == TOKEN["STRING"]) {
            v := curToken["literal"]
            nextToken()
            return {"type": "String", "value": v}
        }
        if (curToken["type"] == TOKEN["SYMBOL"]) {
            v := curToken["literal"]
            nextToken()
            if (v == "true") {
                return {"type": "Boolean", "value": true}
            }
            if (v == "false") {
                return {"type": "Boolean", "value": false}
            }
            if (v == "nil") {
                return {"type": "Nil"}
            }
            return {"type": "Symbol", "value": v}
        }

        msg := "unexpected token in atom: " + curToken["literal"]
        nextToken()
        return {"type": "Error", "value": msg}
    }

    parseList := fn() {
        nextToken()
        elements := []

        loop {
            if (curToken["type"] == TOKEN["RPAREN"] || curToken["type"] == TOKEN["EOF"]) {
                break
            }
            elements = push(elements, exprRef["fn"]())
        }
        if (curToken["type"] != TOKEN["RPAREN"]) {
            return {"type": "Error", "value": "missing closing parenthesis"}
        }
        nextToken()
        return {"type": "List", "elements": elements}
    }

    parseExpression := fn() {
        if (curToken["type"] == TOKEN["QUOTE"]) {
            nextToken()
            expr := exprRef["fn"]()
            return {"type": "List", "elements": [{"type": "Symbol", "value": "quote"}, expr]}
        } else if (curToken["type"] == TOKEN["LPAREN"]) {
            return parseList()
        } else {
            return parseAtom()
        }
    }

    exprRef["fn"] = parseExpression

    parseProgram := fn() {
        program := []
        loop {
            if (curToken["type"] == TOKEN["EOF"]) {
                break
            }
            node := parseExpression()
            program = push(program, node)
            if (node["type"] == "Error") {
                break
            }
        }
        return {"type": "Program", "elements": program}
    }

    return {"parseProgram": parseProgram}
}
