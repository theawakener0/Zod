import "std/os" as os
from "lexer.zd" import makeLexer
from "parser.zd" import makeParser
from "evaluator.zd" import eval
from "ast.zd" import astToString
from "builtins.zd" import makeGlobalEnv

stats := {"checks": 0, "failures": 0}
expectedChecks := 98

run := fn(src) {
    lex := makeLexer(src)
    pars := makeParser(lex)
    program := pars["parseProgram"]()
    env := makeGlobalEnv()
    result := {"type": "Nil"}
    forms := program["elements"]
    for (i := 0; i < len(forms); i++) {
        result = eval(forms[i], env)
        if (result["type"] == "Error") {
            return astToString(result)
        }
    }
    return astToString(result)
}

check := fn(name, src, expected) {
    stats["checks"] += 1
    actual := run(src)
    if (actual == expected) {
        println("PASS " + name)
    } else {
        stats["failures"] += 1
        println("FAIL " + name + ": expected " + expected + ", got " + actual)
    }
}

check("integer addition", "(+ 1 2)", "3")
check("nested arithmetic", "(+ 1 (* 2 3))", "7")
check("subtraction", "(- 10 4)", "6")
check("exact division", "(/ 8 2)", "4")
check("float division", "(/ 5 2)", "2.5")
check("float arithmetic", "(+ 1.5 2.5)", "4.0")
check("negative literal", "-5", "-5")
check("signed literal", "+5", "5")
check("negative float", "-1.5", "-1.5")
check("leading-dot float", ".5", "0.5")
check("negative leading-dot float", "-.5", "-0.5")
check("positive leading-dot float", "+.5", "0.5")
check("trailing-dot float", "1.", "1.0")
check("malformed number", "1.2.3", "error: unexpected token in atom: invalid number: 1.2.3")
check("malformed exponent", "1e3", "error: unexpected token in atom: invalid number: 1e3")
check("malformed signed number", "1-2", "error: unexpected token in atom: invalid number: 1-2")
check("define and symbol", "(define x 5) x", "5")
check("if true", "(if true 1 2)", "1")
check("if false", "(if false 1 2)", "2")
check("if truthy number", "(if 0 1 2)", "1")
check("if without else", "(if false 1)", "nil")
check("nil is falsey", "(if nil 1 2)", "2")
check("empty string is truthy", "(if \"\" 1 2)", "1")
check("empty list is truthy", "(if '() 1 2)", "1")
check("lambda identity", "((lambda (x) x) 7)", "7")
check("lambda arithmetic", "((lambda (x) (+ x 1)) 41)", "42")
check("lambda multi-form body", "((lambda (x) (define y 2) (+ x y)) 5)", "7")
check("closure", "(define add5 (lambda (n) (lambda (x) (+ x n)))) ((add5 5) 3)", "8")
check("begin", "(begin (define y 2) (* y 3))", "6")
check("recursion", "(define fact (lambda (n) (if (<= n 1) 1 (* n (fact (- n 1)))))) (fact 6)", "720")
check("zero-arg lambda", "((lambda () 42))", "42")
check("shadowing", "(define x 1) ((lambda (x) x) 2) x", "1")
check("parent scope", "(define x 1) ((lambda () x))", "1")
check("duplicate params", "(lambda (x x) x)", "error: duplicate lambda parameter: x")
check("quote list", "'(1 2 3)", "(1 2 3)")
check("empty quote", "'()", "()")
check("empty form", "()", "nil")
check("quote symbol", "'foo", "foo")
check("string literal", "\"hello\"", "\"hello\"")
check("string escape", "\"a\\\"b\"", "\"a\\\"b\"")
check("empty string", "\"\"", "\"\"")
check("string newline escape", "\"a\\nb\"", "\"a\\nb\"")
check("string tab escape", "\"a\\tb\"", "\"a\\tb\"")
check("string cr escape", "\"a\\rb\"", "\"a\\rb\"")
check("string backslash escape", "\"a\\\\b\"", "\"a\\\\b\"")
check("string unknown escape", "\"a\\qb\"", "\"a\\\\qb\"")
check("string unicode", "\"héllo 😀\"", "\"héllo 😀\"")
check("string equality", "(= \"a\" \"a\")", "true")
check("string inequality", "(= \"a\" \"b\")", "false")
check("nil literal", "nil", "nil")
check("nil binding", "(define n nil) n", "nil")
check("equality", "(= 1 1)", "true")
check("equality false", "(= 1 2)", "false")
check("equality type strict", "(= 1 1.0)", "false")
check("list equality", "(= '(1 2) '(1 2))", "true")
check("list inequality", "(= '(1 2) '(1 3))", "false")
check("nil equality", "(= nil nil)", "true")
check("boolean equality", "(= true false)", "false")
check("function inequality", "(= print print)", "false")
check("lambda inequality", "(= (lambda (x) x) (lambda (x) x))", "false")
check("list of builtins inequality", "(= (list print) (list print))", "false")
check("nested list equality", "(= (list (list 1 2)) (list (list 1 2)))", "true")
check("empty list equality", "(= '() '())", "true")
check("list length inequality", "(= '(1) '(1 2))", "false")
check("comparison", "(< 1 2)", "true")
check("comparison type error", "(< \"a\" \"b\")", "error: < expects numbers, got String")
check("comparison boolean error", "(< true 1)", "error: < expects numbers, got Boolean")
check("greater than", "(> 2 1)", "true")
check("less or equal", "(<= 1 1)", "true")
check("greater or equal false", "(>= 1 2)", "false")
check("list builtin", "(list 1 2 3)", "(1 2 3)")
check("mixed list", "(list 1 \"a\" true nil)", "(1 \"a\" true nil)")
check("unbound variable", "nope", "error: unbound variable: nope")
check("wrong arity", "((lambda (x) x) 1 2)", "error: wrong number of arguments: expected 1, got 2")
check("equality arity", "(= 1)", "error: = expects 2 arguments, got 1")
check("addition arity", "(+ 1)", "error: + expects 2 arguments, got 1")
check("parse error", "(+ 1", "error: missing closing parenthesis")
check("comments", "; ignored\n(+ 1 2)", "3")
check("division by zero", "(/ 1 0)", "error: division by zero")
check("float division by zero", "(/ 1.0 0)", "error: division by zero")
check("float zero divisor", "(/ 1 0.0)", "error: division by zero")
check("type error", "(+ 1 \"x\")", "error: + expects numbers, got String")
check("if arity", "(if)", "error: if expects 2 or 3 arguments")
check("define arity", "(define x)", "error: define expects a name and a value")
check("quote arity", "(quote 1 2)", "error: quote expects 1 argument")
check("lambda arity", "(lambda)", "error: lambda expects parameters and a body")
check("illegal token", "]", "error: unexpected token in atom: ]")
check("unterminated string", "\"abc", "error: unexpected token in atom: unterminated string")
check("nested parse error", "(] ) (+ 1 2)", "error: unexpected token in atom: ]")
check("quote parse error", "'(]", "error: unexpected token in atom: ]")
check("quote eof", "'", "error: unexpected end of input")
check("lambda body parse error", "(lambda () (] )", "error: unexpected token in atom: ]")
check("if branch parse error", "(if false (] 1) 2)", "error: unexpected token in atom: ]")
check("comment CR", "; c\r(+ 1 2)", "3")
check("integer overflow", "9223372036854775808", "error: invalid integer literal: 9223372036854775808")
check("runtime integer wrap", "(+ 9223372036854775807 1)", "-9223372036854775808")
check("negative integer overflow", "-9223372036854775809", "error: invalid integer literal: -9223372036854775809")
check("float overflow", ".0", "error: invalid float literal: .0")

if (stats["checks"] != expectedChecks) {
    println("FAILED: expected " + string(expectedChecks) + " checks, ran " + string(stats["checks"]))
    os.exit(1)
}
println("")
if (stats["failures"] == 0) {
    println("OK: " + string(stats["checks"]) + " checks passed")
    os.exit(0)
} else {
    println("FAILED: " + string(stats["failures"]) + " of " + string(stats["checks"]) + " checks failed")
    os.exit(1)
}
