pub makeEnv := fn(outer) {
    {
        "store": {},
        "outer": outer
    }
}

pub envGet := fn(env, name) {
    if(contains(env["store"], name)) {
        env["store"][name]
    } else if (env["outer"] != null) {
        envGet(env["outer"], name)
    } else {
        {"type": "Error", "message": "unbound variable: " + name}
    }
}

pub envSet := fn(env, name, value) {
    env["store"][name] = value
    value
}

