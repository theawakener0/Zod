import "std/str" as str

pub astToString := fn(node) {
    if (node["type"] == "Integer" || node["type"] == "Float") {
        string(node["value"])
    } else if (node["type"] == "String") {
        "\"" + node["value"] + "\""
    } else if (node["type"] == "Symbol") {
        node["value"]
    } else if (node["type"] == "Boolean") {
        if (node["value"]) { "true" } else { "false" }
    } else if (node["type"] == "Nil") {
        "nil"
    } else if (node["type"] == "List") {
        parts := []
        for (i := 0; i < len(node["elements"]); i++) {
            parts = push(parts, astToString(node["elements"][i]))
        }
        "(" + str.join(parts, " ") + ")"
    } else {
        "<unknown>"
    }
} 

