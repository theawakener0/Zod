import "std/str" as str

escapeString := fn(s) {
    needsEscape := false
    for (i := 0; i < len(s); i++) {
        c := str.slice(s, i, i + 1)
        if (c == "\"" || c == "\\" || c == "\n" || c == "\t" || c == "\r") {
            needsEscape = true
            break
        }
    }
    if (!needsEscape) {
        return s
    }

    result := ""
    start := 0
    for (i := 0; i < len(s); i++) {
        c := str.slice(s, i, i + 1)
        replacement := null
        if (c == "\"") {
            replacement = "\\\""
        } else if (c == "\\") {
            replacement = "\\\\"
        } else if (c == "\n") {
            replacement = "\\n"
        } else if (c == "\t") {
            replacement = "\\t"
        } else if (c == "\r") {
            replacement = "\\r"
        }
        if (replacement != null) {
            result += str.slice(s, start, i) + replacement
            start = i + 1
        }
    }
    result += str.slice(s, start, len(s))
    return result
}

pub astToString := fn(node) {
    if (node == null) {
        return "<null>"
    }
    if (node["type"] == "Integer" || node["type"] == "Float") {
        return string(node["value"])
    }
    if (node["type"] == "String") {
        return "\"" + escapeString(node["value"]) + "\""
    }
    if (node["type"] == "Symbol") {
        return node["value"]
    }
    if (node["type"] == "Boolean") {
        if (node["value"]) {
            return "true"
        }
        return "false"
    }
    if (node["type"] == "Nil") {
        return "nil"
    }
    if (node["type"] == "Error") {
        return "error: " + node["value"]
    }
    if (node["type"] == "Function") {
        return "<function>"
    }
    if (node["type"] == "Builtin") {
        return "<builtin>"
    }
    if (node["type"] == "List") {
        parts := []
        elements := node["elements"]
        for (i := 0; i < len(elements); i++) {
            parts = push(parts, astToString(elements[i]))
        }
        return "(" + str.join(parts, " ") + ")"
    }
    return "<unknown:" + node["type"] + ">"
}
