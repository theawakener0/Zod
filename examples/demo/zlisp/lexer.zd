import "std/str" as str
from "token.zd" import TOKEN

pub makeLexer := fn(input) {
    pos := 0
    readPos := 0
    ch := null

    charAt := fn(i) {
        if (i < 0 || i >= len(input)) {
            return null
        }
        return str.slice(input, i, i + 1)
    }

    readChar := fn() {
        if (readPos >= len(input)) {
            ch = null
        } else {
            ch = charAt(readPos)
        }
        pos = readPos
        readPos += 1
    }

    peekChar := fn() {
        if (readPos >= len(input)) {
            return null
        }
        return charAt(readPos)
    }

    skipWhitespace := fn() {
        loop {
            if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r") {
                readChar()
            } else {
                break
            }
        }
    }

    skipComment := fn() {
        loop {
            if (ch == null || ch == "\n" || ch == "\r") {
                break
            }
            readChar()
        }
    }

    isLetter := fn(c) {
        if (c == null) {
            return false
        }
        return str.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-?!+*/><=", c)
    }

    isDigit := fn(c) {
        if (c == null) {
            return false
        }
        return str.contains("0123456789", c)
    }

    isNumberStart := fn() {
        if (isDigit(ch)) {
            return true
        }
        if (ch == ".") {
            return isDigit(peekChar())
        }
        if (ch == "-" || ch == "+") {
            p := peekChar()
            if (isDigit(p)) {
                return true
            }
            if (p == "." && isDigit(charAt(readPos + 1))) {
                return true
            }
        }
        return false
    }

    readSymbol := fn() {
        start := pos
        loop {
            if (ch == null || !(isLetter(ch) || isDigit(ch))) {
                break
            }
            readChar()
        }
        return str.slice(input, start, pos)
    }

    readNumber := fn() {
        start := pos
        hasDot := false
        if (ch == "-" || ch == "+") {
            readChar()
        }
        loop {
            if (ch == null) {
                break
            }
            if (isDigit(ch)) {
                readChar()
            } else if (ch == "." && !hasDot) {
                hasDot = true
                readChar()
            } else {
                break
            }
        }
        return {"literal": str.slice(input, start, pos), "isFloat": hasDot}
    }

    readString := fn() {
        readChar()
        start := pos
        end := start
        terminated := false
        loop {
            if (ch == null) {
                end = pos
                break
            }
            if (ch == "\"") {
                terminated = true
                end = pos
                readChar()
                break
            }
            if (ch == "\\") {
                readChar()
                if (ch == null) {
                    end = pos
                    break
                }
                readChar()
            } else {
                readChar()
            }
        }

        chars := str.split(str.slice(input, start, end), "")
        i := 0
        loop {
            if (i >= len(chars)) {
                break
            }
            if (chars[i] == "\\" && i + 1 < len(chars)) {
                next := chars[i + 1]
                if (next == "n") {
                    chars[i] = ""
                    chars[i + 1] = "\n"
                } else if (next == "t") {
                    chars[i] = ""
                    chars[i + 1] = "\t"
                } else if (next == "r") {
                    chars[i] = ""
                    chars[i + 1] = "\r"
                } else if (next == "\\") {
                    chars[i] = ""
                    chars[i + 1] = "\\"
                } else if (next == "\"") {
                    chars[i] = ""
                    chars[i + 1] = "\""
                }
                i += 1
            }
            i += 1
        }
        return {"literal": str.join(chars, ""), "terminated": terminated}
    }

    nextToken := fn() {
        loop {
            skipWhitespace()
            if (ch == ";") {
                skipComment()
            } else {
                break
            }
        }

        if (ch == null) {
            return {"type": TOKEN["EOF"], "literal": ""}
        }

        if (ch == "(") {
            tok := {"type": TOKEN["LPAREN"], "literal": "("}
            readChar()
            return tok
        }
        if (ch == ")") {
            tok := {"type": TOKEN["RPAREN"], "literal": ")"}
            readChar()
            return tok
        }
        if (ch == "'") {
            tok := {"type": TOKEN["QUOTE"], "literal": "'"}
            readChar()
            return tok
        }
        if (ch == "\"") {
            s := readString()
            if (!s["terminated"]) {
                return {"type": TOKEN["ILLEGAL"], "literal": "unterminated string"}
            }
            return {"type": TOKEN["STRING"], "literal": s["literal"]}
        }
        if (isNumberStart()) {
            start := pos
            num := readNumber()
            if (isLetter(ch) || ch == ".") {
                loop {
                    if (ch == null || !(isLetter(ch) || isDigit(ch) || ch == ".")) {
                        break
                    }
                    readChar()
                }
                return {"type": TOKEN["ILLEGAL"], "literal": "invalid number: " + str.slice(input, start, pos)}
            }
            if (num["isFloat"]) {
                return {"type": TOKEN["FLOAT"], "literal": num["literal"]}
            }
            return {"type": TOKEN["INT"], "literal": num["literal"]}
        }
        if (isLetter(ch)) {
            sym := readSymbol()
            return {"type": TOKEN["SYMBOL"], "literal": sym}
        }

        bad := ch
        readChar()
        return {"type": TOKEN["ILLEGAL"], "literal": bad}
    }

    readChar()

    return {"nextToken": nextToken}
}
