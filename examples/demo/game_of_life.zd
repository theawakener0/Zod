// GAME OF LIFE : NEON
// An animated, toroidal Conway's Game of Life for the Zod terminal.
// Cells are painted by age: newborn (blue) -> young (green) -> mature
// (yellow) -> old (orange) -> ancient (magenta).

let CLR = "\x1b[2J"
let HOME = "\x1b[H"
let HIDE = "\x1b[?25l"
let SHOW = "\x1b[?25h"
let BOLD = "\x1b[1m"
let RST = "\x1b[0m"

let AGES = [
	"\x1b[48;5;39m \x1b[0m",
	"\x1b[48;5;2m \x1b[0m",
	"\x1b[48;5;3m \x1b[0m",
	"\x1b[48;5;208m \x1b[0m",
	"\x1b[48;5;196m \x1b[0m",
	"\x1b[48;5;5m \x1b[0m"
]

let mod = fn(a, b) { a - (a / b) * b }

let buildGrid = fn(rows, cols, val) {
	let g = []
	for (i := 0; i < rows; i++) {
		g = push(g, make(cols, val))
	}
	g
}

let population = fn(g) {
	let count = 0
	for (r := 0; r < len(g); r++) {
		for (c := 0; c < len(g[r]); c++) {
			count = count + g[r][c]
		}
	}
	count
}

let neighbors = fn(g, r, c) {
	let count = 0
	let rows = len(g)
	let cols = len(g[0])
	for (dr := -1; dr <= 1; dr++) {
		for (dc := -1; dc <= 1; dc++) {
			if (dr == 0 && dc == 0) { continue }
			count = count + g[mod(r + dr + rows, rows)][mod(c + dc + cols, cols)]
		}
	}
	count
}

let step = fn(g, age) {
	let rows = len(g)
	let cols = len(g[0])
	let next = buildGrid(rows, cols, 0)
	let nage = buildGrid(rows, cols, 0)
	let born = 0
	let died = 0
	for (r := 0; r < rows; r++) {
		for (c := 0; c < cols; c++) {
			let n = neighbors(g, r, c)
			if (g[r][c] == 1) {
				if (n == 2 || n == 3) {
					next[r][c] = 1
					nage[r][c] = age[r][c] + 1
				} else {
					died = died + 1
				}
			} else {
				if (n == 3) {
					next[r][c] = 1
					nage[r][c] = 1
					born = born + 1
				}
			}
		}
	}
	return {"grid": next, "age": nage, "born": born, "died": died}
}

let BLINKER = [
	[0, 1, 2]
]

let GLIDER = [
	[1],
	[2],
	[0, 1, 2]
]

let PULSAR = [
	[2, 3, 4, 8, 9, 10],
	[],
	[0, 5, 7, 12],
	[0, 5, 7, 12],
	[0, 5, 7, 12],
	[2, 3, 4, 8, 9, 10],
	[],
	[2, 3, 4, 8, 9, 10],
	[0, 5, 7, 12],
	[0, 5, 7, 12],
	[0, 5, 7, 12],
	[],
	[2, 3, 4, 8, 9, 10]
]

let PENTA = [
	[],
	[2, 3, 8, 9],
	[1, 4, 6, 9],
	[1, 4, 6, 9],
	[2, 3, 8, 9],
	[]
]

let GUN = [
	[24],
	[22, 24],
	[12, 13, 20, 21, 34, 35],
	[11, 15, 20, 21, 34, 35],
	[0, 1, 10, 16, 20, 21],
	[0, 1, 10, 14, 16, 17, 22, 24],
	[10, 16, 24],
	[11, 15],
	[12, 13]
]

let maxWidth = fn(rows) {
	let m = 0
	for (r := 0; r < len(rows); r++) {
		let row = rows[r]
		if (len(row) > 0) {
			if (row[len(row) - 1] + 1 > m) { m = row[len(row) - 1] + 1 }
		}
	}
	m
}

let stampCenter = fn(g, rows) {
	let r0 = (len(g) - len(rows)) / 2
	let c0 = (len(g[0]) - maxWidth(rows)) / 2
	for (r := 0; r < len(rows); r++) {
		let cols = rows[r]
		for (k := 0; k < len(cols); k++) {
			g[r0 + r][c0 + cols[k]] = 1
		}
	}
}

let seedRandom = fn(g, density) {
	for (r := 0; r < len(g); r++) {
		for (c := 0; c < len(g[r]); c++) {
			if (random() < density) { g[r][c] = 1 }
		}
	}
}

let render = fn(g, age, gen, pop, born, died, peak, name) {
	printf("%s%s", CLR, HOME)
	let hud = BOLD + color("CYAN", name) + RST +
		"   Gen " + string(gen) +
		"   Pop " + color("GREEN", string(pop)) +
		"   Born " + color("GREEN", string(born)) +
		"   Died " + color("RED", string(died)) +
		"   Peak " + string(peak)
	println(hud)
	for (r := 0; r < len(g); r++) {
		let line = "  "
		for (c := 0; c < len(g[r]); c++) {
			if (g[r][c] == 1) {
				let a = age[r][c]
				if (a > 5) { a = 5 }
				line = line + AGES[a]
			} else {
				line = line + " "
			}
		}
		println(line)
	}
	println("  " + AGES[0] + " newborn   " + AGES[1] + " young   " +
		AGES[2] + " mature   " + AGES[3] + " old   " + AGES[5] + " ancient")
}

let showMenu = fn() {
	printf("%s%s", CLR, HOME)
	println("")
	println(BOLD + color("CYAN", "  ===== GAME OF LIFE : NEON =====") + RST)
	println("")
	println("  " + color("GREEN", "1") + "  Blinker")
	println("  " + color("GREEN", "2") + "  Glider")
	println("  " + color("YELLOW", "3") + "  Pulsar")
	println("  " + color("YELLOW", "4") + "  Pentadecathlon")
	println("  " + color("MAGENTA", "5") + "  Gosper Glider Gun")
	println("  " + color("BLUE", "6") + "  Random Soup")
	println("  " + color("RED", "0") + "  Quit")
	println("")
}

let ROWS = 24
let COLS = 60
let MAXGEN = 400
let playing = true

for (playing) {
	showMenu()

	let choice = int(input("  Choose (0-6): "))
	if (choice == 0) { break }

	let g = buildGrid(ROWS, COLS, 0)
	let name = ""
	if (choice == 1) { name = "Blinker"; stampCenter(g, BLINKER) }
	elseif (choice == 2) { name = "Glider"; stampCenter(g, GLIDER) }
	elseif (choice == 3) { name = "Pulsar"; stampCenter(g, PULSAR) }
	elseif (choice == 4) { name = "Pentadecathlon"; stampCenter(g, PENTA) }
	elseif (choice == 5) { name = "Gosper Glider Gun"; stampCenter(g, GUN) }
	elseif (choice == 6) { name = "Random Soup"; seedRandom(g, 0.35) }
	else {
		println("  " + color("RED", "Invalid choice. Try again."))
		continue
	}

	println("")
	println("  Speed: " + color("GREEN", "1") + " fast   " +
		color("YELLOW", "2") + " medium   " + color("RED", "3") + " slow")
	let spd = int(input("  Choose (1-3): "))
	let delay = 0
	if (spd == 1) { delay = 30 }
	elseif (spd == 2) { delay = 80 }
	else { delay = 150 }

	let age = buildGrid(ROWS, COLS, 0)
	let gen = 0
	let pop = population(g)
	let peak = pop
	let born = 0
	let died = 0
	let reason = "generation limit"

	printf("%s", HIDE)

	loop {
		render(g, age, gen, pop, born, died, peak, name)
		sleep(delay)
		let res = step(g, age)
		g = res["grid"]
		age = res["age"]
		born = res["born"]
		died = res["died"]
		gen = gen + 1
		pop = population(g)
		if (pop > peak) { peak = pop }
		if (pop == 0) { reason = "the colony went extinct"; break }
		if (born == 0 && died == 0) { reason = "the colony reached a still life"; break }
		if (gen >= MAXGEN) { reason = "the generation limit was reached"; break }
	}

	printf("%s", SHOW)

	printf("%s%s", CLR, HOME)
	println("")
	println(BOLD + color("CYAN", "  ===== Simulation Complete =====") + RST)
	println("")
	println("  Pattern        : " + name)
	println("  Generations    : " + string(gen))
	println("  Final pop      : " + color("GREEN", string(pop)))
	println("  Peak pop       : " + color("YELLOW", string(peak)))
	println("  Stop reason    : " + color("RED", reason))
	println("")
	let again = input("  Play again? (y/n): ")
	if (again != "y" && again != "Y") { playing = false }
}

println("")
println(color("GREEN", "  Thanks for watching! Goodbye."))
