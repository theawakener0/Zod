// =================================
// AI harness with TUI in ZodLang
// =================================

import "std/term" as term
import "std/fmt" as fmt
import "std/str" as str
import "std/array" as arr
import "std/hash" as hash
import "std/json" as json
import "std/os" as os
import "std/fs" as fs

import "agentic/client.zd" as client
import "agentic/messages.zd" as messages
import "agentic/tools.zd" as tools
import "agentic/agent.zd" as agent
import "agentic/coding_tools.zd" as coding_tools


pub new_ui := fn(cwd) {
    return {
        "cwd": cwd,
        "log": [],
        "input": "",
        "status": "ready",
        "running": true
    }
}

pub log_line := fn(ui, line) {
    ui["log"] = arr.push(ui["log"], line)
    if (len(ui["log"]) > 200) {
        ui["log"] = arr.slice(ui["log"], len(ui["log"]) - 200, len(ui["log"]))
    }
}

pub draw := fn(ui) {
    if (ui["quiet"] != null && ui["quiet"]) { return null }
    W := 80
    H := 24
    wr := try(term.width())
    if (wr[0]) { W = wr[1] }
    hr := try(term.height())
    if (hr[0]) { H = hr[1] }
    if (W < 40) { W = 80 }
    if (H < 10) { H = 24 }

    log_h := H - 3
    lines := ui["log"]
    start := 0
    if (len(lines) > log_h) { start = len(lines) - log_h }

    out := term.sync_begin() + term.hide_cursor() + term.home()
    out += term.bold() + term.color("CYAN", " The Zoddler ") + term.reset()
    out += term.dim() + " cwd=" + ui["cwd"] + " (agentic lib)" + term.reset() + "\n"

    for (row := 0; row < log_h; row += 1) {
        idx := start + row
        line := ""
        if (idx < len(lines)) { line = lines[idx] }
        if (len(line) > W - 1) { line = str.slice(line, 0, W - 1) }
        line = str.pad_right(line, W, " ")
        out += line + "\n"
    }

    status := ui["status"]
    status_col := "GREEN"
    if (status == "thinking") { status_col = "YELLOW" }
    else if (status == "tool") { status_col = "MAGENTA" }
    if (status == "error") { status_col = "RED" }
    bar := " [" + status + "] enter=send ctrl-l=clear ctrl-c=quit"
    if (len(bar) > W) { bar = str.slice(bar, 0, W) }
    bar = str.pad_right(bar, W, " ")
    out += term.color(status_col, bar) + "\n"

    prompt := "> " + ui["input"]
    if (len(prompt) > W - 1) { prompt = str.slice(prompt, len(prompt) - (W - 1), len(prompt)) }
    prompt = str.pad_right(prompt, W, " ")
    out += prompt
    out += term.sync_end()

    fmt.print(out)
}

pub submit := fn(ui, ag) {
    msg := ui["input"]
    ui["input"] = ""
    if (msg == "") { return null }
    if (msg == ":q" || msg == "/quit" || msg == "/exit") {
        ui["running"] = false
        return null
    }

    log_line(ui, "you: " + msg)
    ui["status"] = "thinking"
    draw(ui)

    result := try(ag["run"](msg))
    if (!result[0]) {
        ui["status"] = "error"
        log_line(ui, "error: " + result[1])
    } else {
        ui["status"] = "ready"
        if (result[1] != null && result[1] != "") {
            log_line(ui, "assistant: " + result[1])
        }
    }
    draw(ui)
}

pub handle_key := fn(ui, ag, key) {
    if (key == null) { return null }
    if (key == "\x03") {
        ui["running"] = false
        return null
    }
    if (key == "\x0c") {
        ui["log"] = []
        ui["input"] = ""
        return null
    }
    if (key == "\r" || key == "\n") {
        submit(ui, ag)
        return null
    }
    if (key == "\x7f" || key == "\x08") {
        if (len(ui["input"]) > 0) {
            ui["input"] = str.slice(ui["input"], 0, len(ui["input"]) - 1)
        }
        return null
    }
    if (str.starts_with(key, "\x1b")) { return null }
    if (len(key) == 1) { ui["input"] += key }
}

pub make_coding_tools := fn(ui) {
    base := coding_tools.make_coding_tools(ui["cwd"], null)
    explore := tools.make_tool(
        "explore",
        "Read-only subagent for code exploration. Pass a task; it may only read files and returns a summary.",
        {
            "type": "object",
            "properties": {"task": {"type": "string"}},
            "required": ["task"]
        },
        fn(args) {
            log_line(ui, "subagent explore: " + args["task"])
            draw(ui)
            child_r := try(client.new_client(null, null))
            if (!child_r[0]) { return "Error: " + child_r[1] }
            child := agent.new_agent(
                child_r[1],
                coding_tools.make_readonly_tools(ui["cwd"]),
                "You are a subagent. You are an expert in code exploring. Only use read tools. Summarize briefly. Do not write files.",
                5
            )
            r := try(child["run"](args["task"]))
            if (!r[0]) { return "Error: " + r[1] }
            return r[1]
        }
    )

    return arr.push(base, explore)
}

pub main := fn() {
    ui := new_ui(os.cwd())
    cli_r := try(client.new_client(null, "anthropic/claude-haiku-5.5"))
    if (!cli_r[0]) {
        fmt.println("client error: " + cli_r[1])
        return null
    }
    cli := cli_r[1]
    all_tools := make_coding_tools(ui)
    ag := agent.new_agent(
        cli,
        all_tools,
        "You are a coding AI. You are an expert in code reading and writing. Use read_file, write_file, edit, glob, grep, bash, todo, and the explore subagent. Keep answers short.",
        8
    )

    log_line(ui, "agentic harness ready. tools: read_file, write_file, edit, glob, grep, bash, todo, explore")
    log_line(ui, "type a task and press enter")

    raw := try(term.enable_raw())
    if (!raw[0]) {
        ui["quiet"] = true
        fmt.println("no TTY detected, using line mode. type /quit to exit.")
        line := ""
        loop {
            line = term.input("> ")
            if (line == "/quit" || line == "/exit" || line == ":q") { break }
            if (line != "") {
                ui["input"] = line
                submit(ui, ag)
                last := ui["log"][len(ui["log"]) - 1]
                fmt.println(last)
            }
        }
        fmt.println("bye")
    } else {
        term.clear()
        draw(ui)

        key := null
        loop {
            if (!ui["running"]) { break }
            key = term.wait_key(100)
            if (key != null) {
                handle_key(ui, ag, key)
                if (ui["running"]) { draw(ui) }
            }
        }

        term.disable_raw()
        fmt.print(term.show_cursor())
        term.clear()
        fmt.println("bye")
    }

    conv := ag["conversation"]
    s := try(fs.write_file(
        "session.json",
        json.stringify({
            "cwd": ui["cwd"],
            "messages": conv["to_api"](conv)
        })
    ))
}

main()
