pub get := fn(url) {
  return __http_get(url, 10000)
}

pub get_timeout := fn(url, ms) {
  return __http_get(url, ms)
}

pub post := fn(url, body) {
  return __http_post(url, body, 10000)
}

pub post_headers := fn(url, body, headers) {
  return __http_post_headers(url, body, headers, 10000)
}

pub post_timeout := fn(url, body, ms) {
  return __http_post_headers(url, body, headers, ms)
}
