pub get := fn(url) {
  return __http_get(url, 10000)
}

pub get_timeout := fn(url, ms) {
  return __http_get(url, ms)
}

pub post := fn(url, body) {
  return __http_post(url, body, 10000)
}

pub post_headers := fn(url, body, headers) {
  return __http_post_headers(url, body, headers, 10000)
}

pub post_timeout := fn(url, body, headers, ms) {
  return __http_post_headers(url, body, headers, ms)
}

pub post_stream := fn(url, body, headers) {
  return __http_post_stream(url, body, headers, 120000)
}

pub post_stream_timeout := fn(url, body, headers, ms) {
  return __http_post_stream(url, body, headers, ms)
}

pub stream_start := fn(url, body, headers) {
  return __stream_start(url, body, headers, 120000)
}

pub stream_start_timeout := fn(url, body, headers, ms) {
  return __stream_start(url, body, headers, ms)
}

pub stream_poll := fn(h) {
  return __stream_poll(h)
}

pub stream_cancel := fn(h) {
  return __stream_cancel(h)
}

pub stream_close := fn(h) {
  return __stream_close(h)
}
