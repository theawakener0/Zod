pub join := fn(a, b) {
  if (a == "") {
    return b
  }
  if (b == "") {
    return a
  }
  let ae = __str_slice(a, len(a) - 1, len(a)) == "/"
  let bs = __str_slice(b, 0, 1) == "/"
  if (ae) {
    if (bs) {
      return __str_slice(a, 0, len(a) - 1) + b
    }
    return a + b
  }
  if (bs) {
    return a + b
  }
  return a + "/" + b
}

pub basename := fn(p) {
  if (p == "") {
    return ""
  }
  let parts = __str_split(p, "/")
  return parts[len(parts) - 1]
}

pub dirname := fn(p) {
  let parts = __str_split(p, "/")
  if (len(parts) <= 1) {
    return "."
  }
  let out = parts[0]
  for (i := 1; i < len(parts) - 1; i++) {
    out = out + "/" + parts[i]
  }
  if (out == "") {
    return "/"
  }
  return out
}

pub ext := fn(p) {
  let b = basename(p)
  let parts = __str_split(b, ".")
  if (len(parts) <= 1) {
    return ""
  }
  return "." + parts[len(parts) - 1]
}
