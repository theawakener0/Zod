pub color := fn(name, s) {
  let v = string(s)
  if (name == "RED") {
    return "\x1b[31m" + v + "\x1b[0m"
  }
  if (name == "GREEN") {
    return "\x1b[32m" + v + "\x1b[0m"
  }
  if (name == "YELLOW") {
    return "\x1b[33m" + v + "\x1b[0m"
  }
  if (name == "BLUE") {
    return "\x1b[34m" + v + "\x1b[0m"
  }
  if (name == "MAGENTA") {
    return "\x1b[35m" + v + "\x1b[0m"
  }
  if (name == "CYAN") {
    return "\x1b[36m" + v + "\x1b[0m"
  }
  return v
}

pub input := fn(prompt) {
  __print(string(prompt))
  return __read_line()
}

pub clear := fn() {
  __print("\x1b[2J\x1b[H")
}

pub width := fn() {
  return __term_width()
}

pub height := fn() {
  return __term_height()
}

pub size := fn() {
  return [__term_width(), __term_height()]
}

pub read_key := fn() {
  return __read_key()
}

pub has_input := fn() {
  return __has_input()
}

pub hide_cursor := fn() {
  return "\x1b[?25l"
}

pub show_cursor := fn() {
  return "\x1b[?25h"
}

pub home := fn() {
  return "\x1b[H"
}

pub move := fn(x, y) {
  return "\x1b[" + string(int(y)) + ";" + string(int(x)) + "H"
}

pub bold := fn() {
  return "\x1b[1m"
}

pub dim := fn() {
  return "\x1b[2m"
}

pub reset := fn() {
  return "\x1b[0m"
}

pub sync_begin := fn() {
  return "\x1b[?2026h"
}

pub sync_end := fn() {
  return "\x1b[?2026l"
}

pub key_name := fn(k) {
  let key = string(k)
  if (key == "\x1b[A" || key == "w" || key == "W") {
    return "up"
  }
  if (key == "\x1b[B" || key == "s" || key == "S") {
    return "down"
  }
  if (key == "\x1b[C" || key == "d" || key == "D") {
    return "right"
  }
  if (key == "\x1b[D" || key == "a" || key == "A") {
    return "left"
  }
  if (key == " ") {
    return "space"
  }
  if (key == "\r" || key == "\n") {
    return "enter"
  }
  if (key == "\x1b") {
    return "esc"
  }
  if (key == "q" || key == "Q") {
    return "q"
  }
  return key
}

pub poll_key := fn() {
  if (__has_input()) {
    let k = __read_key()
    // The Go reader returns "" when it consumed a truncated SGR tail
    // and has no further buffered byte; that is not a key.
    if (k == "") {
      return null
    }
    return k
  }
  return null
}

pub wait_key := fn(timeout_ms) {
  let start = __now_ms()
  loop {
    if (__has_input()) {
      let k = __read_key()
      if (k != "") {
        return k
      }
    }
    if (__now_ms() - start >= timeout_ms) {
      return null
    }
    __sleep_ms(5)
  }
}

// Mouse support uses SGR encoding (DECSET 1006) with button-event
// tracking (1000 + 1002). Motion reports arrive only while a button is
// held, which is exactly what drag-to-look needs. Raw mode must be
// enabled first.
pub enable_mouse := fn() {
  return __term_mouse_enable()
}

pub disable_mouse := fn() {
  return __term_mouse_disable()
}

// Alternate-screen tracking lets TermCleanup leave the screen only when
// the script actually entered it. Prefer these over printing DECSET 1049
// directly.
pub enter_alt_screen := fn() {
  return __term_alt_screen_enter()
}

pub leave_alt_screen := fn() {
  return __term_alt_screen_leave()
}

// is_decimal accepts only ASCII digits. int() otherwise auto-detects
// bases and signs ("0x10", "+10"), which must not pass as mouse fields.
let is_decimal = fn(s) {
  if (len(s) == 0) {
    return false
  }
  for (i := 0; i < len(s); i++) {
    if (__str_index("0123456789", __str_slice(s, i, i + 1)) < 0) {
      return false
    }
  }
  return true
}

// parse_mouse decodes one SGR mouse report:
//   ESC [ < Cb ; Cx ; Cy M   (press or motion)
//   ESC [ < Cb ; Cx ; Cy m   (release)
// Coordinates are 1-based terminal cells. Cb packs the button in the low
// two bits, modifiers in bits 2-4, motion in bit 5 and wheel in bit 6.
// Returns null for anything that is not a complete SGR report.
pub parse_mouse := fn(seq) {
  let s = string(seq)
  if (len(s) < 9) {
    return null
  }
  if (__str_slice(s, 0, 3) != "\x1b[<") {
    return null
  }
  let last = __str_slice(s, len(s) - 1, len(s))
  if (last != "M" && last != "m") {
    return null
  }
  let body = __str_slice(s, 3, len(s) - 1)
  let parts = __str_split(body, ";")
  if (len(parts) != 3) {
    return null
  }
  if (!is_decimal(parts[0]) || !is_decimal(parts[1]) || !is_decimal(parts[2])) {
    return null
  }
  // int() returns an Error value on malformed input, and a bare let of
  // an Error aborts the VM. try() turns the conversion into a value.
  let cb_r = try(int(parts[0]))
  let x_r = try(int(parts[1]))
  let y_r = try(int(parts[2]))
  if (!cb_r[0] || !x_r[0] || !y_r[0]) {
    return null
  }
  let cb = cb_r[1]
  let x = x_r[1]
  let y = y_r[1]
  if (cb < 0 || cb > 255) {
    return null
  }
  if (x < 1 || y < 1) {
    return null
  }
  let low = cb % 4
  let wheel = int(cb / 64) % 2 == 1
  let motion = int(cb / 32) % 2 == 1
  let extended = int(cb / 128) % 2 == 1
  let button = low
  if (extended) {
    // Extended buttons occupy 8..11. Keeping button 0 for them would
    // make an extended press look like a left click.
    button = 8 + low
  }
  if (wheel) {
    button = 64 + low
  }
  let action = "press"
  if (last == "m") {
    action = "release"
    if (!wheel && !extended && low == 3) {
      // Generic SGR release: normalize it to left so drag tracking
      // ends the same way as an X10 release.
      button = 0
    }
  }
  if (motion && last == "M") {
    action = "move"
  }
  return {
    "x": x,
    "y": y,
    "button": button,
    "action": action,
    "shift": int(cb / 4) % 2 == 1,
    "alt": int(cb / 8) % 2 == 1,
    "ctrl": int(cb / 16) % 2 == 1,
    "wheel": wheel,
    "motion": motion,
    "extended": extended
  }
}

// parse_x10_mouse decodes the three payload bytes of a legacy X10
// report. X10 coordinates are 1-based and offset by 32.
let parse_x10_mouse = fn(b0, b1, b2) {
  let cb = b0 - 32
  let x = b1 - 32
  let y = b2 - 32
  if (cb < 0 || cb > 255 || x < 1 || y < 1) {
    return null
  }
  let low = cb % 4
  let wheel = int(cb / 64) % 2 == 1
  let motion = int(cb / 32) % 2 == 1
  let extended = cb >= 128
  let button = low
  if (extended) {
    button = 8 + low
  }
  if (wheel) {
    button = 64 + low
  }
  let action = "press"
  if (!wheel && !motion && low == 3) {
    // X10 has no per-button release code: 3 means "a button was
    // released". Normalize it to left so drag tracking still ends.
    action = "release"
    button = 0
  }
  if (motion) {
    // Motion with low == 3 is a hover (no button held); keep the
    // action consistent with SGR hover reports.
    action = "move"
  }
  return {
    "x": x,
    "y": y,
    "button": button,
    "action": action,
    "shift": int(cb / 4) % 2 == 1,
    "alt": int(cb / 8) % 2 == 1,
    "ctrl": int(cb / 16) % 2 == 1,
    "wheel": wheel,
    "motion": motion,
    "extended": extended
  }
}

// Legacy X10 reports are ESC [ M followed by three payload bytes. A PTY
// can split the header and payload across reads, so the payload is
// buffered across poll_events calls instead of blocking a frame. The
// 300 ms deadline bounds how long a partial report can hold the buffer.
let x10_state = {"buf": [], "deadline": 0}

let reset_x10 = fn() {
  x10_state["buf"] = []
  x10_state["deadline"] = 0
}

let start_x10 = fn() {
  x10_state["buf"] = []
  x10_state["deadline"] = __now_ms() + 300
}

// read_x10_byte reads one non-ESC byte without blocking.
let read_x10_byte = fn() {
  let r = try(__read_key())
  if (!r[0]) {
    return null
  }
  let s = string(r[1])
  let h = __hex_encode(s)
  if (len(h) != 2) {
    return null
  }
  let v = try(int("0x" + h))
  if (!v[0]) {
    return null
  }
  return v[1]
}

// poll_x10 finishes a buffered X10 report when all three payload bytes
// have arrived. It never sleeps; an incomplete report simply resumes on
// the next frame.
let poll_x10 = fn() {
  if (x10_state["deadline"] == 0) {
    return null
  }
  let buf = x10_state["buf"]
  loop {
    if (len(buf) >= 3) {
      let m = parse_x10_mouse(buf[0], buf[1], buf[2])
      reset_x10()
      return m
    }
    if (__now_ms() >= x10_state["deadline"]) {
      reset_x10()
      return null
    }
    if (!__has_input()) {
      return null
    }
    let b = read_x10_byte()
    if (b == null) {
      reset_x10()
      return null
    }
    x10_state["buf"] = __arr_push(buf, b)
    buf = x10_state["buf"]
  }
}

// poll_events drains everything currently waiting on stdin and returns
// key and mouse events in arrival order. Keeping this as one drain per
// frame lets the game coalesce a burst of drag reports before rendering.
// The cap prevents a mouse flood from starving the frame. Truncated SGR
// tails are filtered in the Go reader, before they reach this function.
pub poll_events := fn() {
  let events = []
  let max_events = 256
  let reads = 0
  loop {
    // Count reads as well as events: ignored malformed reports and
    // discarded tails append nothing, so an event-only cap could let a
    // pathological input flood delay the frame indefinitely.
    if (len(events) >= max_events - 1 || reads >= max_events) {
      break
    }
    reads = reads + 1
    let xm = poll_x10()
    if (xm != null) {
      events = __arr_push(events, {"type": "mouse", "mouse": xm})
      continue
    }
    if (!__has_input()) {
      break
    }
    let r = try(__read_key())
    if (!r[0]) {
      break
    }
    let s = string(r[1])
    if (s == "") {
      // The Go reader may consume a truncated SGR tail and return no
      // key. Do not turn that into an empty key event or block the
      // frame waiting for a future key.
      continue
    }
    if (s == "\x1b[M") {
      start_x10()
    } else if (s == "\x1b\x1b[M") {
      // ESC pressed just before an X10 click can be merged by the escape
      // assembler. Emit the ESC, then buffer the X10 payload.
      events = __arr_push(events, {"type": "key", "key": "\x1b"})
      start_x10()
    } else {
      let mouse_seq = s
      if (__str_slice(s, 0, 4) == "\x1b\x1b[<") {
        // A lone ESC pressed just before a click can be merged into the
        // mouse report by the escape assembler. Emit the ESC and decode
        // the remainder as the mouse event.
        events = __arr_push(events, {"type": "key", "key": "\x1b"})
        mouse_seq = __str_slice(s, 1, len(s))
      }
      let mr = try(parse_mouse(mouse_seq))
      let m = null
      if (mr[0]) {
        m = mr[1]
      }
      if (m != null) {
        events = __arr_push(events, {"type": "mouse", "mouse": m})
      } else if (__str_slice(mouse_seq, 0, 3) == "\x1b[<") {
        // Malformed SGR report: ignore rather than feed it to the key
        // handler. The Go reader has already discarded any tail.
      } else {
        events = __arr_push(events, {"type": "key", "key": s})
      }
    }
  }
  return events
}

pub enable_raw := fn() {
    return __term_raw_enable()
}

pub disable_raw := fn() {
    return __term_raw_disable()
}
